# 本地环境变量示例。复制为 .env 后填写；.env 不提交。

# 内容目录：默认使用仓库内 data/，需要读取外部内容时指向自己的目录
# CONTENT_DIR=../my-content

# 站点绝对地址：影响 canonical、sitemap 与 OG 链接，默认 https://newhot.org
# SITE_URL=https://example.com/

# 构建版本号：写入页面 meta 与数据分片地址，默认取构建时间
# PUBLIC_BUILD_ID=

# 上线前封禁收录：设为 1 时全站 noindex
SITE_NOINDEX=

# 可选：流量统计与站长验证
PUBLIC_GA_ID=
PUBLIC_BAIDU_TONGJI_ID=
PUBLIC_BING_VERIFICATION=
