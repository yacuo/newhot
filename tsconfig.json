{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@site-content/config/*": ["config/*"]
    },
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*.ts",
    "astro.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    ".next"
  ]
}
