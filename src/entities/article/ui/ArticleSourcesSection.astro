---
import type { PostMeta } from "@/entities/article/model/schema";

type Props = { sources?: PostMeta["sources"] };
const { sources } = Astro.props;
const primary = sources?.[0];
---

{sources?.length && primary ? (
  <section aria-labelledby="article-sources-title" class="mt-14 border-t border-slate-200 pt-5">
    <h2
      id="article-sources-title"
      class="text-xs font-medium uppercase tracking-[0.14em] text-slate-400"
    >
      来源
    </h2>
    <ul class="mt-3 space-y-1.5">
      {sources.map((source) => (
        <li class="text-[13px] leading-6 text-slate-500">
          <a
            href={source.url}
            target="_blank"
            rel="noreferrer"
            class="underline decoration-slate-300 underline-offset-2 transition-colors hover:text-slate-700"
          >
            {source.title}
          </a>
          {source.publisher ? <span> · {source.publisher}</span> : null}
          {source.accessedAt ? <span class="text-slate-400"> · {source.accessedAt}</span> : null}
        </li>
      ))}
    </ul>
  </section>
) : null}
