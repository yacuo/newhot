---
import { pillActiveClass, pillIdleClass, pillTrayClass } from "@/shared/ui/classes";

type Tab = { id: string; label: string; href: string; active?: boolean };
type Props = { tabs: Tab[]; activeTabId?: string; meta?: string; class?: string; interactive?: boolean };

const { tabs, activeTabId, meta, interactive = false } = Astro.props;
const className = Astro.props.class ?? "";
const selected = activeTabId ?? tabs.find((tab) => tab.active)?.id;
---
<div class={className} data-tabs={interactive ? "" : undefined}>
  <div class="flex items-center justify-between gap-4">
    <div class="-mx-1 min-w-0 overflow-x-auto px-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <nav aria-label="二级导航" class={pillTrayClass}>
        {tabs.map((tab) => {
          const isActive = tab.id === selected;
          const tabClass = `inline-flex shrink-0 items-center rounded-full px-4 py-1.5 text-sm transition ${isActive ? pillActiveClass : pillIdleClass}`;

          return interactive ? (
            <button
              type="button"
              data-tab-target={tab.id}
              aria-pressed={isActive ? "true" : "false"}
              class={tabClass}
            >
              <span>{tab.label}</span>
            </button>
          ) : (
            <a href={tab.href} aria-current={isActive ? "page" : undefined} class={tabClass}>
              <span>{tab.label}</span>
            </a>
          );
        })}
      </nav>
    </div>

    {meta ? <p class="hidden shrink-0 font-mono text-[11px] tracking-[0.04em] text-slate-500 xl:block">{meta}</p> : null}
  </div>

  {meta ? <p class="mt-3 text-right font-mono text-[11px] tracking-[0.04em] text-slate-500 sm:text-left xl:hidden">{meta}</p> : null}
</div>
