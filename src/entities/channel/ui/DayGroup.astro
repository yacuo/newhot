---
type Props = { date: string; weekday: string; count: number };
const { date, weekday, count } = Astro.props;
const [, month, day] = date.split("-");
---
<div data-day-group data-day-date={date} class="border-t border-slate-100 first:border-t-0">
  <button
    type="button"
    data-day-toggle
    aria-expanded="true"
    class="group relative grid w-full grid-cols-1 items-center gap-1 py-4 text-left xl:grid-cols-[148px_minmax(0,1fr)] xl:gap-x-8"
  >
    <span class="pointer-events-none absolute left-0 top-0 hidden h-full w-[148px] border-r border-slate-200 xl:block"></span>

    <time datetime={date} class="text-[22px] font-semibold leading-7 tracking-tight text-slate-950">
      {Number(month)}月{Number(day)}日
    </time>

    <span class="flex items-center gap-2 text-[11px] leading-4 text-slate-400">
      <span data-day-chevron class="flex h-4 w-4 shrink-0 items-center justify-center transition-transform duration-200 xl:hidden">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </span>
      <span data-day-count>{weekday} · {count} 篇</span>
    </span>

    <span class="absolute left-[147.5px] top-1/2 hidden h-7 w-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-indigo-200 bg-indigo-50 text-indigo-600 transition-colors group-hover:border-indigo-300 group-hover:bg-indigo-100 group-hover:text-indigo-700 xl:flex">
      <svg data-day-chevron viewBox="0 0 24 24" aria-hidden="true" class="h-[18px] w-[18px] transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </span>
  </button>

  <ol data-day-list class="m-0 list-none p-0"><slot /></ol>
</div>
