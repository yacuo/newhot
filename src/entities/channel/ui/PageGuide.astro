---
import { getChannelSources, type SourceLink } from "@/shared/config/sources";
import { pagePanelClass } from "@/shared/ui/classes";
import { sharedPage } from "@/entities/page-content/model/shared";

type Props = {
  heading: string;
  description: string;
  topicId?: string;
  points?: string[];
  sources?: SourceLink[];
  quote?: { text: string; label: string; href: string } | null;
  panel?: boolean;
  sourcesHeading?: string;
  sourcesDescription?: string;
  largeHeading?: boolean;
};

const defaults = sharedPage.guide.defaults;

const {
  heading,
  description,
  topicId,
  points,
  sources,
  quote = defaults.quote,
  panel = true,
  sourcesHeading = defaults.sourcesHeading,
  sourcesDescription = defaults.sourcesDescription,
  largeHeading = false,
} = Astro.props;

const items = points ?? defaults.points;
const links = sources ?? getChannelSources(topicId);
const headingClass = largeHeading
  ? "text-xl font-semibold tracking-tight text-slate-950 md:text-2xl"
  : "text-base font-semibold text-slate-900";
---
<section class={panel ? `mt-5 ${pagePanelClass}` : "mt-8 border-t border-slate-200 pt-6"}>
  <h2 class={headingClass}>{heading}</h2>
  <p class="mt-3 text-sm leading-7 text-slate-600">{description}</p>

  <ul class="mt-4 space-y-2 text-sm leading-7 text-slate-600">
    {items.map((point) => (
      <li class="flex gap-2">
        <span aria-hidden="true" class="mt-[11px] h-1.5 w-1.5 flex-none rounded-full bg-indigo-400"></span>
        <span>{point}</span>
      </li>
    ))}
  </ul>

  <h2 class={`mt-8 ${headingClass}`}>{sourcesHeading}</h2>
  <p class="mt-3 text-sm leading-7 text-slate-600">{sourcesDescription}</p>

  <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
    {links.map((source) => (
      <li>
        <a href={source.href} target="_blank" rel="noreferrer" class="text-sm font-medium text-indigo-600 hover:underline">
          {source.name}
        </a>
      </li>
    ))}
  </ul>

  {quote ? (
    <blockquote class="mt-4 border-l-2 border-indigo-300 pl-4 text-sm leading-7 text-slate-600">
      「{quote.text}」<cite class="ml-2 not-italic text-slate-400">——{" "}<a href={quote.href} target="_blank" rel="noreferrer" class="text-indigo-600 hover:underline">{quote.label}</a></cite>
    </blockquote>
  ) : null}
</section>
