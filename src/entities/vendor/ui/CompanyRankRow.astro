---
import { getTopicAccent, getTopicLabel } from "@/entities/channel/model";
import { companyHref, companyTierLabels, getCompanyModel } from "@/entities/vendor/model/model";
import type { CompanySummary } from "@/entities/vendor/model/summary";
import { getCompanyAccent, getCompanyInitials } from "@/entities/vendor/model/taxonomy";
import { formatMonthDay } from "@/shared/lib/utils";

type Props = {
  summary: CompanySummary;
  rank: number;
  maxCount: number;
};

const { summary, rank, maxCount } = Astro.props;
const accent = getCompanyAccent(summary.company.tier);
const model = getCompanyModel(summary.company);
const products = summary.company.products;
const productText =
  products.length > 0 ? products.slice(0, 3).map((product) => product.name).join(" · ") : companyTierLabels[summary.company.tier];
const percent = maxCount > 0 ? Math.max(6, Math.round((summary.articleCount / maxCount) * 100)) : 0;
const channelChips = summary.channels.slice(0, 3).map((id) => ({
  id,
  label: getTopicLabel(id),
  dot: getTopicAccent(id).dot,
}));
---
<li>
  <a
    href={companyHref(summary.company.id)}
    class="group -mx-2 grid grid-cols-[22px_40px_minmax(0,1fr)_64px] items-center gap-3 rounded-lg px-2 py-3 transition-colors hover:bg-indigo-50/70 sm:grid-cols-[22px_40px_minmax(0,1fr)_64px_64px] lg:grid-cols-[22px_40px_minmax(0,1fr)_220px_64px_64px_minmax(100px,1fr)] xl:grid-cols-[22px_40px_minmax(180px,1fr)_240px_64px_64px_64px_minmax(140px,1fr)] 2xl:grid-cols-[22px_40px_280px_300px_64px_64px_64px_minmax(160px,1fr)]"
  >
    <span class="font-mono text-[11px] tabular-nums text-slate-300">{String(rank).padStart(2, "0")}</span>

    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white ring-1 ring-slate-900/[0.06]">
      {summary.company.logo ? (
        <img
          src={summary.company.logo}
          alt={`${summary.company.name} 标志`}
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="h-5 w-5 object-contain transition-transform duration-300 group-hover:scale-110"
        />
      ) : (
        <span class={`text-sm font-bold ${accent.text}`}>{getCompanyInitials(summary.company.name)}</span>
      )}
    </span>

    <div class="min-w-0">
      <div class="flex items-baseline gap-1.5">
        <h3 class="truncate text-[15px] font-semibold leading-6 tracking-[-0.01em] text-slate-950 transition-colors group-hover:text-indigo-600">
          {summary.company.name}
        </h3>
        {model ? <span class="truncate text-xs text-slate-400">/ {model}</span> : null}
      </div>
      <p class="mt-0.5 truncate text-[12px] leading-4 text-slate-400">{productText}</p>
    </div>

    <div class="hidden min-w-0 flex-nowrap items-center gap-1.5 overflow-hidden lg:flex">
      {channelChips.map((chip) => (
        <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-slate-50 px-2 py-0.5 text-[11px] leading-4 text-slate-500 ring-1 ring-slate-900/[0.04]">
          <span class={`h-1.5 w-1.5 rounded-full ${chip.dot}`}></span>
          {chip.label}
        </span>
      ))}
    </div>

    <div class="w-16 whitespace-nowrap text-right">
      <span class="font-mono text-[13px] tabular-nums text-slate-900">{summary.articleCount}</span>
      <span class="ml-1 text-[10px] text-slate-400">篇动态</span>
    </div>

    <div class="hidden w-16 whitespace-nowrap text-right sm:block">
      <span class="font-mono text-[13px] tabular-nums text-slate-600">{summary.channelCount}</span>
      <span class="ml-1 text-[10px] text-slate-400">个频道</span>
    </div>

    <div class="hidden w-16 whitespace-nowrap text-right xl:block">
      <span class="font-mono text-[13px] tabular-nums text-slate-600">{products.length}</span>
      <span class="ml-1 text-[10px] text-slate-400">个产品</span>
    </div>

    <div class="hidden min-w-0 items-center gap-3 lg:flex">
      <div class="h-1.5 min-w-0 flex-1 overflow-hidden rounded-full bg-slate-100">
        <div class="h-full rounded-full bg-gradient-to-r from-indigo-400 to-indigo-500" style={`width:${percent}%`}></div>
      </div>
      <span class="w-20 shrink-0 text-right text-[10px] leading-4 text-slate-400">
        {summary.lastUpdated ? `更新 ${formatMonthDay(summary.lastUpdated)}` : "暂无动态"}
      </span>
    </div>
  </a>
</li>
