---
import type { HistoryEvent, HistoryKind } from "@/entities/vendor/model/history";

type Props = { events: HistoryEvent[] };

const { events } = Astro.props;

const kindLabels: Record<HistoryKind, string> = {
  founding: "公司",
  "project-start": "起点",
  model: "模型",
  product: "产品",
  research: "研究",
  org: "组织",
  funding: "融资",
  milestone: "里程碑",
};

const kindHue: Record<HistoryKind, string> = {
  founding: "kind-h-company",
  "project-start": "kind-h-start",
  model: "kind-h-model",
  product: "kind-h-product",
  research: "kind-h-research",
  org: "kind-h-org",
  funding: "kind-h-funding",
  milestone: "kind-h-milestone",
};

const formatDate = (event: HistoryEvent) => {
  const [year, month, day] = event.date.split("-");
  if (event.datePrecision === "year") return `${year}年`;
  if (event.datePrecision === "month") return `${year}年${Number(month)}月`;
  return `${year}年${Number(month)}月${Number(day)}日`;
};

const startYear = events.reduce((min, event) => Math.min(min, Number(event.date.slice(0, 4))), Infinity);
---
<div>
  <div class="flex items-center justify-between gap-3">
    <div class="flex items-baseline gap-2">
      <h2 class="text-base font-semibold text-slate-950">发展史</h2>
      <span class="font-mono text-[11px] tracking-[0.04em] text-slate-400">{startYear} 年至今</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="whitespace-nowrap font-mono text-[11px] tracking-[0.04em] text-slate-400">
        {events.length} 个节点 · 左右滑动
      </span>
      <div class="flex flex-none items-center gap-1">
        <button
          type="button"
          data-history-prev
          aria-label="向前翻一屏"
          disabled
          class="flex h-8 w-8 items-center justify-center rounded-full border border-indigo-200 bg-indigo-50 text-indigo-600 transition-colors hover:border-indigo-300 hover:bg-indigo-100 hover:text-indigo-700 disabled:cursor-default disabled:border-slate-200 disabled:bg-transparent disabled:text-slate-300"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button
          type="button"
          data-history-next
          aria-label="向后翻一屏"
          class="flex h-8 w-8 items-center justify-center rounded-full border border-indigo-200 bg-indigo-50 text-indigo-600 transition-colors hover:border-indigo-300 hover:bg-indigo-100 hover:text-indigo-700 disabled:cursor-default disabled:border-slate-200 disabled:bg-transparent disabled:text-slate-300"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="relative mt-5">
    <div
      data-history-scroll
      class="select-none overflow-x-auto overscroll-x-contain pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      <div class="relative flex min-w-max gap-3 md:gap-4">
        <span aria-hidden="true" class="absolute left-4 right-4 top-[132px] h-px bg-slate-200"></span>

        {events.map((event, index) => {
          const hue = kindHue[event.kind] ?? kindHue.milestone;
          const card = (
            <div class="relative rounded-xl bg-surface p-3 ring-1 ring-slate-900/[0.06] shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-all duration-200 group-hover:-translate-y-0.5 group-hover:shadow-[0_10px_24px_-14px_rgba(15,23,42,0.3)] group-hover:ring-indigo-200/70">
              <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
                <span class="font-mono text-[10px] tracking-[0.02em] text-slate-400">{formatDate(event)}</span>
                <span class={`kind-tag ${hue} rounded-full px-1.5 py-[1px] text-[10px] font-medium`}>{kindLabels[event.kind] ?? "里程碑"}</span>
                {event.origin === "site" ? <span class="accent-text whitespace-nowrap text-[10px] font-medium">站内打开</span> : null}
              </div>
              <p class="history-title mt-1.5 truncate text-[13px] font-semibold leading-5 text-slate-900">{event.title}</p>
              {event.highlights.length ? (
                <div class="mt-1 space-y-0.5">
                  {event.highlights.slice(0, 2).map((highlight) => (
                    <p class="truncate text-[11px] leading-4 text-slate-600" title={`${highlight.label} ${highlight.value}`}>
                      <span class="accent-text font-medium">{highlight.label}</span> {highlight.value}
                    </p>
                  ))}
                </div>
              ) : null}
            </div>
          );

          return (
            <div data-history-item class="relative h-[266px] w-[180px] flex-none md:w-[198px]">
              <span aria-hidden="true" class={`kind-dot ${hue} absolute left-[10px] top-[132px] h-2.5 w-2.5 -translate-y-1/2 rounded-full ring-4 ring-surface`}></span>
              <div class={index % 2 === 0 ? "absolute bottom-[142px] left-0 right-0" : "absolute left-0 right-0 top-[142px]"}>
                {event.articleHref ? <a href={event.articleHref} class="history-link group block">{card}</a> : card}
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <span aria-hidden="true" data-history-fade="left" hidden class="pointer-events-none absolute inset-y-0 left-0 w-10 bg-gradient-to-r from-surface to-transparent"></span>
    <span aria-hidden="true" data-history-fade="right" hidden class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-surface to-transparent"></span>
  </div>
</div>

<script>
  import "@/features/history-timeline/model/history";
</script>
