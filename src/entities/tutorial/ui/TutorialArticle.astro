---
import ArticleFaqSection from "@/entities/article/ui/ArticleFaqSection.astro";
import MobileArticleToc from "@/features/article-toc/ui/MobileArticleToc.astro";
import TableOfContents from "@/features/article-toc/ui/TableOfContents.astro";
import Icon from "@/shared/ui/Icon.astro";
import ColumnToc from "./ColumnToc.astro";
import MobileColumnToc from "./MobileColumnToc.astro";
import type { Post } from "@/entities/article/model/schema";
import { findTutorialArticle, type ResolvedTutorialCatalog } from "@/entities/tutorial/model";

type Props = {
  catalog: ResolvedTutorialCatalog;
  post: Post;
};

const { catalog, post } = Astro.props;

const catalogArticle = findTutorialArticle(catalog, post.slug);
if (!catalogArticle) throw new Error(`教程文章不在目录中：${catalog.id}/${post.slug}`);

const catalogArticles = catalog.sections.flatMap((section) =>
  section.articles.filter((article) => !article.external && article.post),
);
const currentArticleIndex = catalogArticles.findIndex((article) => article.slug === post.slug);
const previousArticle = currentArticleIndex > 0 ? catalogArticles[currentArticleIndex - 1] : undefined;
const nextArticle = currentArticleIndex >= 0 ? catalogArticles[currentArticleIndex + 1] : undefined;
const nextReads =
  currentArticleIndex >= 0 ? catalogArticles.slice(currentArticleIndex + 1, currentArticleIndex + 4) : [];
const visibleTags = post.tags.slice(0, 5);
---
<MobileColumnToc column={catalog} activeSlug={post.slug} />
<MobileArticleToc headings={post.headings} />

<article class="grid justify-center gap-x-8 pt-3 lg:grid-cols-[clamp(180px,16vw,280px)_minmax(0,860px)_clamp(150px,12vw,190px)] xl:grid-cols-[clamp(180px,16vw,280px)_minmax(0,860px)_clamp(200px,15vw,280px)]">
  <div class="hidden lg:col-start-1 lg:row-span-3 lg:row-start-1 lg:block">
    <div class="sticky top-[var(--site-article-sticky-offset)]">
      <a
        href={`/tutorials/${catalog.id}/`}
        class="group -ml-1 -mt-1 inline-flex items-center gap-1.5 px-1 py-0.5 text-[13px] font-medium leading-5 text-slate-600 transition-colors hover:text-indigo-600"
      >
        <Icon name="ArrowLeft" size={14} strokeWidth={2} class="transition-transform group-hover:-translate-x-0.5" />
        返回系列目录
      </a>
    </div>
  </div>

  <nav
    aria-label="面包屑"
    class="mb-8 flex flex-wrap items-center gap-1.5 border-b border-slate-200/80 pb-3 pr-[5.75rem] text-[13px] text-slate-500 lg:col-start-2 lg:row-start-1 xl:pr-0"
  >
    <a href="/" class="transition-colors hover:text-indigo-500">首页</a>
    <span aria-hidden="true" class="text-slate-300">/</span>
    <a href="/tutorials/" class="transition-colors hover:text-indigo-500">系列教程</a>
    <span aria-hidden="true" class="text-slate-300">/</span>
    <a href={`/tutorials/${catalog.id}/`} class="transition-colors hover:text-indigo-500">{catalog.title}</a>
    <span aria-hidden="true" class="text-slate-300">/</span>
    <span class="text-slate-700">{catalogArticle.section.title}</span>
  </nav>

  <div class="lg:col-start-2 lg:row-start-2">
    <div class="border-b border-slate-200/70 pb-4">
      <h1 class="text-[21px] font-bold leading-tight tracking-tight text-slate-950 md:text-[26px]">{post.title}</h1>
    </div>
  </div>

  <aside class="hidden lg:col-start-1 lg:row-start-3 lg:block">
    <div class="sticky top-[calc(var(--site-article-sticky-offset)_+_33px)] max-h-[calc(100vh-var(--site-article-sticky-offset)-1rem)] overflow-y-auto overflow-x-hidden">
      <div class="pr-2">
        <div class="mb-3 border-b border-slate-200/70">
          <span class="sr-only">本系列目录</span>
        </div>
        <ColumnToc column={catalog} activeSlug={post.slug} />
      </div>
    </div>
  </aside>

  <div class="min-w-0 lg:col-start-2 lg:row-start-3">
    <header class="border-b border-slate-100 pb-6">
      {visibleTags.length > 0 ? (
        <div class="mt-4 flex flex-wrap gap-2">
          {visibleTags.map((tag) => (
            <span class="theme-tag rounded px-3 py-1 text-xs">{tag}</span>
          ))}
        </div>
      ) : null}
      <div class="mt-4 rounded-xl bg-slate-50 px-4 py-3 ring-1 ring-slate-900/[0.06]">
        <p class="text-sm leading-6 text-slate-600">{post.description}</p>
      </div>
    </header>

    <section aria-label="文章正文" class="prose mt-8 max-w-none" set:html={post.html} />
    <ArticleFaqSection faqs={post.faqs} />

    <nav aria-label="上一篇和下一篇" class="mt-10 space-y-1 border-t border-slate-200 pt-6">
      {previousArticle ? (
        <a href={previousArticle.href} class="group -mx-3 block rounded-lg px-3 py-3 transition-colors hover:bg-slate-100">
          <span class="flex items-center gap-2 text-xs font-medium text-slate-500 transition-colors group-hover:text-indigo-600">
            <span class="flex h-5 w-5 flex-none items-center justify-center rounded-full bg-gradient-to-br from-sky-500 to-indigo-600 text-[color:var(--accent-on)] shadow-[0_2px_6px_rgba(37,99,235,0.28)]">
              <Icon name="ArrowLeft" size={12} strokeWidth={2.6} />
            </span>
            上一篇
          </span>
          <span class="mt-1.5 line-clamp-2 block text-sm font-medium leading-6 text-slate-900 transition-colors group-hover:text-indigo-600">
            {previousArticle.sidebarTitle}
          </span>
        </a>
      ) : null}
      {nextArticle ? (
        <a href={nextArticle.href} class="group -mx-3 block rounded-lg px-3 py-3 text-right transition-colors hover:bg-slate-100">
          <span class="flex items-center justify-end gap-2 text-xs font-medium text-slate-500 transition-colors group-hover:text-indigo-600">
            下一篇
            <span class="flex h-5 w-5 flex-none items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-500 text-[color:var(--accent-on)] shadow-[0_2px_6px_rgba(99,102,241,0.28)]">
              <Icon name="ArrowRight" size={12} strokeWidth={2.6} />
            </span>
          </span>
          <span class="mt-1.5 line-clamp-2 block text-sm font-medium leading-6 text-slate-900 transition-colors group-hover:text-indigo-600">
            {nextArticle.sidebarTitle}
          </span>
        </a>
      ) : null}
    </nav>

    {nextReads.length > 0 ? (
      <section class="mt-5 border-t border-slate-200 pt-6">
        <div class="flex items-center justify-between pb-3">
          <h2 class="text-base font-bold text-slate-950">下一步阅读</h2>
          <span class="text-xs text-slate-500">同系列教程推荐</span>
        </div>
        <ul class="space-y-1">
          {nextReads.map((item) => (
            <li>
              <a href={item.href} class="group -mx-3 block rounded-lg px-3 py-3 transition-colors hover:bg-slate-100">
                <span class="line-clamp-1 text-sm font-normal text-slate-950 transition-colors group-hover:text-indigo-600 md:text-base">
                  {item.sidebarTitle}
                </span>
                {item.description ? (
                  <span class="mt-1 line-clamp-2 block text-sm leading-6 text-slate-500">{item.description}</span>
                ) : null}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null}
  </div>

  <aside class="hidden lg:col-start-3 lg:row-start-3 lg:block">
    <div class="sticky -mt-[33px] top-[var(--site-article-sticky-offset)] max-h-[calc(100vh-var(--site-article-sticky-offset)-1rem)] overflow-y-auto">
      <p class="mb-3 border-b border-slate-200/70 pb-3 text-sm font-medium text-slate-950">文章目录</p>
      <TableOfContents headings={post.headings} showTitle={false} />
    </div>
  </aside>
</article>
