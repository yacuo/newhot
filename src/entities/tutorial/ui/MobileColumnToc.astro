---
import ColumnToc from "./ColumnToc.astro";
import type { ResolvedTutorialCatalog } from "@/entities/tutorial/model";

type Props = {
  column: ResolvedTutorialCatalog;
  activeSlug?: string;
};

const { column, activeSlug } = Astro.props;
---
<button
  type="button"
  data-mobile-column-toggle
  aria-label="打开系列教程目录"
  aria-expanded="false"
  class="fixed right-[3.75rem] top-[calc(var(--site-header-height)+8px)] z-30 flex h-9 w-9 items-center justify-center rounded-full border border-slate-200/80 bg-surface/95 text-slate-600 shadow-[0_4px_14px_rgba(15,23,42,0.12)] backdrop-blur transition-colors hover:text-slate-950 lg:hidden"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 5h13M13 12h8M13 19h8M3 10a2 2 0 0 0 2 2h3M3 5v12a2 2 0 0 0 2 2h3" />
  </svg>
</button>

<aside
  data-mobile-column
  class="fixed left-0 top-[var(--site-header-height)] z-30 h-[calc(100vh-var(--site-header-height))] w-[min(17rem,84vw)] overflow-y-auto bg-surface p-4 shadow-[8px_0_30px_rgba(15,23,42,0.12)] lg:hidden"
>
  <nav aria-label="移动端系列教程目录">
    <div class="mb-3 flex items-center justify-between">
      <div class="flex items-baseline gap-1.5">
        <span class="text-[15px] font-semibold text-slate-950">系列目录</span>
        <span class="text-[11px] text-slate-400">{column.articleCount} 篇</span>
      </div>
      <button
        type="button"
        data-mobile-column-close
        aria-label="关闭系列目录"
        class="flex h-7 w-7 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
    <ColumnToc column={column} activeSlug={activeSlug} label="移动端系列教程目录" compact />
  </nav>
</aside>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-column-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-mobile-column]");

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      root.toggleAttribute("data-column-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "关闭系列教程目录" : "打开系列教程目录");
    };

    toggle.addEventListener("click", () => setOpen(!root.hasAttribute("data-column-open")));
    document.querySelector("[data-mobile-column-close]")?.addEventListener("click", () => setOpen(false));

    for (const link of Array.from(document.querySelectorAll("[data-mobile-column-link]"))) {
      link.addEventListener("click", () => setOpen(false));
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
