---
import Root from "@/layouts/Root.astro";
import Shell from "@/layouts/Shell.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { siteConfig } from "@/shared/site";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";
import { contactPage } from "@/modules/page-content";

const { seo, header, channels, footer } = contactPage;

/** 内容里用 repository 指代源码仓库，避免把地址写死在两份数据里 */
const resolveHref = (href: string) => (href === "repository" ? siteConfig.repository : href);
---

<Root title={seo.title} description={seo.description} path={seo.path}>
  <Shell mainClassName={widePageContainerClass}>
    <div class="space-y-5">
      <PageHeader eyebrow={header.eyebrow} title={header.title} description={header.description} />

      <article class={pagePanelClass}>
        <div class="grid gap-5 md:grid-cols-3">
          {channels.map((channel) => {
            const href = resolveHref(channel.action.href);
            return (
              <section class="rounded-md bg-slate-50 p-5">
                <h2 class="text-base font-semibold text-slate-950">{channel.title}</h2>
                <p class="mt-2 text-sm leading-7 text-slate-600">{channel.description}</p>
                <a
                  href={href}
                  target={href.startsWith("http") ? "_blank" : undefined}
                  rel={href.startsWith("http") ? "noreferrer" : undefined}
                  class="mt-4 inline-flex h-9 items-center rounded border border-indigo-200 bg-surface px-4 text-sm font-medium text-indigo-700 transition hover:border-indigo-300 hover:bg-indigo-50"
                >
                  {channel.action.label}
                </a>
              </section>
            );
          })}
        </div>

        <div class="mt-6 space-y-2 border-t border-slate-200 pt-6 text-sm leading-7 text-slate-600">
          <p>
            {footer.label}
            <a href={siteConfig.repository} target="_blank" rel="noreferrer" class="text-indigo-600 hover:underline">{footer.linkLabel}</a>
          </p>
          <p class="text-xs text-slate-400">{footer.note}</p>
        </div>
      </article>
    </div>
  </Shell>
</Root>
