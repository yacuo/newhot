---
import Root from "@/layouts/Root.astro";
import Shell from "@/layouts/Shell.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { siteConfig } from "@/shared/site";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";

const description =
  "联系 NewHot 编辑部：内容纠错、公司补充建议、投稿与合作，都可以通过 GitHub 仓库的 Issue 与我们取得联系。";

const channels = [
  {
    title: "内容纠错",
    description: "发现公司归属、官网地址、版本号或发布时间有误，请在仓库提交 Issue，并附上可核实的官方来源。",
    action: { label: "在 GitHub 查看", href: siteConfig.repository },
  },
  {
    title: "公司补充建议",
    description: "希望新增某家公司、产品或某个方向的动态，请说明它属于哪家公司、对应的官方更新页在哪里。",
    action: { label: "在 GitHub 查看", href: siteConfig.repository },
  },
  {
    title: "投稿与合作",
    description: "原创实测、工程实践与报错排查类内容都欢迎；合作需求请在 Issue 中说明背景与预期。",
    action: { label: "查看投稿指南", href: "/contribute/" },
  },
];
---
<Root title="联系我们" description={description} path="/contact/">
  <Shell mainClassName={widePageContainerClass}>
    <div class="space-y-5">
      <PageHeader
        eyebrow="CONTACT"
        title="联系我们"
        description="NewHot 由编辑团队维护，所有反馈都通过公开仓库处理，处理过程与结果对读者可见。"
      />

      <article class={pagePanelClass}>
        <div class="grid gap-5 md:grid-cols-3">
          {channels.map((channel) => (
            <section class="rounded-md bg-slate-50 p-5">
              <h2 class="text-base font-semibold text-slate-950">{channel.title}</h2>
              <p class="mt-2 text-sm leading-7 text-slate-600">{channel.description}</p>
              <a
                href={channel.action.href}
                target={channel.action.href.startsWith("http") ? "_blank" : undefined}
                rel={channel.action.href.startsWith("http") ? "noreferrer" : undefined}
                class="mt-4 inline-flex h-9 items-center rounded border border-indigo-200 bg-surface px-4 text-sm font-medium text-indigo-700 transition hover:border-indigo-300 hover:bg-indigo-50"
              >
                {channel.action.label}
              </a>
            </section>
          ))}
        </div>

        <div class="mt-6 space-y-2 border-t border-slate-200 pt-6 text-sm leading-7 text-slate-600">
          <p>
            仓库地址：
            <a href={siteConfig.repository} target="_blank" rel="noreferrer" class="text-indigo-600 hover:underline">GitHub</a>
          </p>
          <p class="text-xs text-slate-400">反馈与处理结果都会留在 Issue 里，方便后续追溯。</p>
        </div>
      </article>
    </div>
  </Shell>
</Root>
