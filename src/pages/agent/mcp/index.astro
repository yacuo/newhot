---
import Root from "@/layouts/Root.astro";
import Shell from "@/layouts/Shell.astro";
import AgentShell from "@/components/agent/AgentShell.astro";
import Badge from "@/components/agent/Badge.astro";
import CopyButton from "@/components/agent/CopyButton.astro";
import CodeBlock from "@/components/agent/CodeBlock.astro";
import McpClientTabs from "@/components/agent/McpClientTabs.astro";
import InlineText from "@/components/ui/InlineText.astro";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";
import { buildBreadcrumbJsonLd, buildTechArticleJsonLd } from "@/shared/seo/jsonld";
import { agentPage } from "@/modules/page-content";

const { mcp } = agentPage;

const articleJsonLd = buildTechArticleJsonLd({
  headline: mcp.seo.title,
  description: mcp.seo.description,
  path: mcp.seo.path,
  about: ["MCP", "Streamable HTTP", "JSON-RPC"],
});

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "首页", href: "/" },
  { name: "Agent 接入", href: "/agent/" },
  { name: "MCP", href: mcp.seo.path },
]);
---

<Root title={mcp.seo.title} description={mcp.seo.description} path={mcp.seo.path}>
  <Shell mainClassName={widePageContainerClass} selectedChannel="Agent 接入">
    <AgentShell title={mcp.header.title} description={mcp.header.description}>
      <section class={pagePanelClass}>
        <div class="flex flex-wrap gap-2">
          {mcp.badges.map((badge) => <Badge label={badge.label} tone={badge.tone} />)}
        </div>
        <p class="mt-4 text-sm leading-7 text-slate-700">
          <InlineText text={mcp.intro} />
        </p>
      </section>

      <section class={pagePanelClass}>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-semibold tracking-tight text-slate-950">{mcp.setup.title}</h2>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-500">
            {mcp.setup.badge}
          </span>
        </div>

        <ol class="mt-5 divide-y divide-slate-100">
          <li class="py-5 first:pt-0">
            <h3 class="text-base font-semibold tracking-tight text-slate-950">{mcp.setup.endpoint.title}</h3>
            <div class="mt-3">
              <CodeBlock code={mcp.setup.endpoint.code} label="Endpoint" />
            </div>
            <p class="mt-2 text-[13px] leading-6 text-slate-500">
              {mcp.setup.endpoint.note}
            </p>
          </li>

          <li class="py-5">
            <h3 class="text-base font-semibold tracking-tight text-slate-950">{mcp.setup.clients.title}</h3>
            <div class="mt-3">
              <McpClientTabs />
            </div>
          </li>

          <li class="py-5 last:pb-0">
            <h3 class="text-base font-semibold tracking-tight text-slate-950">{mcp.setup.prompt.title}</h3>
            <div class="mt-3 flex flex-wrap items-center gap-2 rounded-xl bg-slate-50 px-4 py-3">
              <span class="text-[13px] text-slate-700">{mcp.setup.prompt.text}</span>
              <CopyButton text={mcp.setup.prompt.text} />
            </div>
            <p class="mt-2 text-[13px] leading-6 text-slate-500">
              {mcp.setup.prompt.note}
            </p>
          </li>
        </ol>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{mcp.tools.title}</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">{mcp.tools.description}</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {mcp.tools.items.map((tool) => (
            <div class="rounded-xl bg-slate-50 p-4">
              <p class="font-mono text-[12px] font-semibold text-slate-900">{tool.name}</p>
              <p class="mt-1.5 text-[13px] leading-6 text-slate-600">{tool.description}</p>
              <p class="mt-2 font-mono text-[11px] text-slate-400">{tool.args}</p>
            </div>
          ))}
        </div>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{mcp.returns.title}</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          <InlineText text={mcp.returns.description} />
        </p>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{mcp.spec.title}</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          <InlineText text={mcp.spec.description} />
        </p>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{mcp.troubleshooting.title}</h2>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-slate-600">
          {mcp.troubleshooting.items.map((item) => (
            <li>
              <span class="font-medium text-slate-900">{item.label}</span>：<InlineText text={item.text} />
            </li>
          ))}
        </ul>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{mcp.alternatives.title}</h2>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-slate-600">
          {mcp.alternatives.items.map((item) => (
            <li><InlineText text={item} /></li>
          ))}
        </ul>
      </section>
    </AgentShell>
  </Shell>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Root>
