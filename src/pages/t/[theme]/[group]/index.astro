---
import View from "@/views/theme-group/index.astro";
import { themes } from "@/entities/vendor/model/themes";

export function getStaticPaths() {
  return themes.flatMap((theme) =>
    theme.groups.map((group) => ({
      params: { theme: theme.id, group: group.id },
      props: { themeId: theme.id, groupId: group.id },
    })),
  );
}
---

<View {...Astro.props} />
