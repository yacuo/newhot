---
import Root from "@/layouts/Root.astro";
import Shell from "@/layouts/Shell.astro";
import ChannelPanel from "@/components/channel/ChannelPanel.astro";
import CompanyCard from "@/components/vendor/CompanyCard.astro";
import PageGuide from "@/components/channel/PageGuide.astro";
import { buildThemeListing, getTheme, getThemeSeo, themeGroupHref, themeHref, themes } from "@/modules/vendor/themes";
import { readFeedMeta } from "@/modules/content";
import { formatMonthDay } from "@/shared/utils";
import { widePageContainerClass, pagePanelClass } from "@/shared/ui/classes";

export function getStaticPaths() {
  return themes.map((theme) => ({ params: { theme: theme.id }, props: { id: theme.id } }));
}

const { id } = Astro.props;
const theme = getTheme(id);
if (!theme) throw new Error(`主题不存在：${id}`);

const seo = getThemeSeo(theme);
const meta = readFeedMeta();
if (!meta) throw new Error("meta.json 未生成");

const listing = buildThemeListing(theme, meta.companies);
const articleCount = listing.summaries.reduce((total, summary) => total + summary.articleCount, 0);
const latest = listing.summaries.reduce<string | null>(
  (value, summary) => (summary.lastUpdated && (!value || summary.lastUpdated > value) ? summary.lastUpdated : value),
  null,
);

const tabs = [
  { id: "all", label: "全部", href: themeHref(theme.id), active: true },
  ...listing.sections.map((section) => ({
    id: section.id,
    label: section.label,
    href: themeGroupHref(theme.id, section.id),
  })),
];
---
<Root title={seo.title} description={seo.description} path={themeHref(theme.id)}>
  <Shell selectedChannel="主题" mainClassName={widePageContainerClass}>
    <ChannelPanel
      title={theme.name}
      eyebrow={theme.eyebrow}
      description={seo.description}
      tabs={tabs}
    />

    <section class={`mt-5 ${pagePanelClass}`}>
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-base font-semibold text-slate-900">全部公司</h2>
        <p class="shrink-0 font-mono text-[11px] tracking-[0.04em] text-slate-400">
          {`${listing.summaries.length} 家公司 · ${articleCount} 篇动态${latest ? ` · 更新至 ${formatMonthDay(latest)}` : ""}`}
        </p>
      </div>

      <div class="mt-5 space-y-5">
        {listing.sections.map((section) => (
          <section data-theme-section={section.id}>
            <div class="mb-3 flex items-baseline gap-2">
              <h3 class="text-[13px] font-semibold tracking-[-0.01em] text-slate-700">{section.label}</h3>
              <span class="font-mono text-[11px] tabular-nums text-slate-400">{section.summaries.length}</span>
            </div>
            <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
              {section.summaries.map((summary) => (
                <CompanyCard summary={summary} tone="muted" />
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <PageGuide
      heading="主题是怎么划分的？"
      description="主题按方向聚合公司；主题下的公司与动态均来自厂商官方渠道，由编辑核对后归档，同一家公司可以出现在多个主题里。"
    />
  </Shell>
</Root>
