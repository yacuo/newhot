---
import Root from "@/layouts/Root.astro";
import Shell from "@/layouts/Shell.astro";
import ChannelPanel from "@/components/channel/ChannelPanel.astro";
import ChannelTabs from "@/components/channel/ChannelTabs.astro";
import ArticleList from "@/components/channel/ArticleList.astro";
import { DEFAULT_SOURCES } from "@/config/sources";
import { readHomeFeed, readFeedMeta } from "@/modules/content";
import { homePage } from "@/modules/page-content/home";
import { HOME_TIERS } from "@/modules/content/list-shards";
import { buildThemeStat, themeHref, themes } from "@/modules/vendor/themes";
import { getSiteUrl, siteConfig } from "@/shared/site";
import { formatMonthDay } from "@/shared/utils";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";

const PRINCIPLES = [
  { title: "官方来源", description: "只采用厂商官方公告、版本说明与官方文档，不采用传闻与二手转述。" },
  { title: "原创整理", description: "标题、摘要与解读由编辑团队原创撰写，不翻译、不搬运。" },
  { title: "人工审核", description: "每条内容发布前逐条核对版本、价格与时间，确认准确后才上线。" },
];

const formatFullDate = (date?: string | null) => {
  if (!date) return "—";
  const [year, month, day] = date.split("-");
  return `${year}年${Number(month)}月${Number(day)}日`;
};

const feed = readHomeFeed();
const meta = readFeedMeta();
if (!feed || !meta) throw new Error("首页数据未生成");

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${siteConfig.name} 精选`,
  url: getSiteUrl("/"),
  description: siteConfig.description,
  inLanguage: siteConfig.language,
  dateModified: meta.latest ?? undefined,
  author: { "@type": "Organization", name: `${siteConfig.name} 编辑部`, url: getSiteUrl("/about/") },
  publisher: { "@type": "Organization", name: siteConfig.name, url: getSiteUrl("/") },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: feed.tiers.all.initial.length,
    itemListElement: feed.tiers.all.initial.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Article",
        headline: item.title,
        url: getSiteUrl(item.href),
        datePublished: item.date,
        author: { "@type": "Organization", name: item.author ?? `${siteConfig.name} 编辑部` },
      },
    })),
  },
};

const tierMeta = [
  { id: "all", label: "全部", description: "按发布时间倒序排列，覆盖模型发布、编程工具、AI 办公、AI 创作与故障排查等方向；点开任意一条查看完整内容与原始来源。" },
  { id: "model", label: "大模型公司", description: "跟踪大模型公司的官方发布，覆盖新模型、参数与上下文、API 价格与限流、服务状态；按发布时间倒序排列。" },
  { id: "tool", label: "工具与应用", description: "跟踪工具与应用类公司的更新，覆盖 AI 编程、AI 办公、AI 创作与智能体工具；按发布时间倒序排列。" },
  { id: "infra", label: "开源与运行时", description: "跟踪开源与运行时相关动态，覆盖本地推理、模型服务、依赖与开发工具链；按发布时间倒序排列。" },
] as const;

const themeRows = themes.map((theme) => ({
  theme,
  companyCount: buildThemeStat(theme, meta.companies).companyCount,
}));
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "NewHot 是什么？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "NewHot 是按发布时间整理 AI 官方更新动态的资讯站，覆盖大模型、AI 编程、AI 办公、AI 创作与故障排查，并为每家公司建立独立档案。",
      },
    },
    {
      "@type": "Question",
      name: "动态从哪里来？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "只收录厂商官方公告、版本说明与官方文档，不采用传闻与二手转述；每条动态标注原始来源、版本与生效时间，经人工核对后发布。",
      },
    },
    {
      "@type": "Question",
      name: "内容覆盖哪些方向？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "按七个主题组织：大模型、AI 编程、AI 办公、AI 创作、智能体与平台、开源与运行时、云平台与算力；每个主题下是一批公司，公司页里才是具体的模型、工具与动态。",
      },
    },
  ],
};

const description = "NewHot 是什么？NewHot 是按发布时间整理 AI 官方更新动态的资讯站，覆盖大模型、AI 编程、AI 办公、AI 创作与故障排查，只收录厂商官方公告与文档，每条标注版本与生效时间。";
---
<Root title={homePage.seo.title} description={homePage.seo.description} path={homePage.seo.path}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <Shell selectedChannel="精选" mainClassName={widePageContainerClass}>
    <ChannelPanel
      title="精选"
      eyebrow="PICKED"
      description={description}
      stats={`${meta.total} 篇文章${meta.latest ? ` · 更新至 ${formatMonthDay(meta.latest)}` : ""}`}
    />

    <section class={`mt-5 ${pagePanelClass}`}>
      <h2 class="text-base font-semibold text-slate-900">NewHot 是什么？</h2>
      <p class="mt-3 text-sm leading-7 text-slate-600">
        NewHot 是一个按发布时间整理 AI 官方更新动态的资讯站：把大模型、AI 编程、AI 办公、AI 创作、智能体与云平台的官方发布整理成动态，经人工审核后发布，并为每家公司建立独立档案。
      </p>

      <ul class="mt-4 grid gap-3 md:grid-cols-3">
        {PRINCIPLES.map((item) => (
          <li class="rounded-md bg-slate-50 p-4">
            <h3 class="text-sm font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-1.5 text-xs leading-6 text-slate-500">{item.description}</p>
          </li>
        ))}
      </ul>

      <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500">
        <span>编辑：<a href="/about/" class="font-medium text-indigo-600 hover:underline">NewHot 编辑部</a></span>
        <span aria-hidden="true" class="text-slate-300">·</span>
        <span>更新于 <time datetime={meta.latest ?? undefined}>{formatFullDate(meta.latest)}</time></span>
      </div>

      <blockquote class="mt-4 border-l-2 border-indigo-300 pl-4 text-sm leading-7 text-slate-600">
        「确保通用人工智能造福全人类。」
        <cite class="ml-2 not-italic text-slate-400">
          —— <a href="https://openai.com/about/" target="_blank" rel="noreferrer" class="text-indigo-600 hover:underline">OpenAI 官方使命</a>
        </cite>
      </blockquote>
    </section>

    <section class={`mt-5 ${pagePanelClass}`}>
      <h2 class="text-base font-semibold text-slate-900">最新动态</h2>

      <ChannelTabs
        tabs={tierMeta.map((tier) => ({ id: tier.id, label: tier.label, href: `#${tier.id}` }))}
        activeTabId="all"
        interactive
        class="mt-3"
      />

      <div class="mt-3">
        {HOME_TIERS.map((id) => {
          const tier = feed.tiers[id];
          const info = tierMeta.find((entry) => entry.id === id)!;
          return (
            <section data-tab-panel={id} hidden={id !== "all"}>
              <p class="mt-3 text-sm leading-6 text-slate-500">{info.description}</p>
              <ArticleList class="mt-3" scope={`_latest/${id}`} total={tier.total} initialItems={tier.initial} showTopic showSubcategory={false} />
            </section>
          );
        })}
      </div>
    </section>

    <section class={`mt-5 ${pagePanelClass}`}>
      <h2 class="text-base font-semibold text-slate-900">内容覆盖哪些方向？</h2>
      <p class="mt-3 text-sm leading-7 text-slate-600">
        目前按七个主题组织：每个主题下是一批公司，公司页里才是具体的模型、工具与动态，这样同一个产品不会被拆散在不同信息流里。
      </p>

      <div class="mt-4 overflow-x-auto thin-scrollbar">
        <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-xs uppercase tracking-[0.08em] text-slate-400">
              <th scope="col" class="py-2 pr-4 font-semibold">主题</th>
              <th scope="col" class="py-2 pr-4 font-semibold">覆盖内容</th>
              <th scope="col" class="py-2 font-semibold">覆盖公司</th>
            </tr>
          </thead>
          <tbody>
            {themeRows.map(({ theme, companyCount }) => (
              <tr class="border-b border-slate-100 align-top last:border-0">
                <th scope="row" class="py-3 pr-4 font-medium text-slate-900">
                  <a href={themeHref(theme.id)} class="hover:text-indigo-600">{theme.name}</a>
                </th>
                <td class="py-3 pr-4 text-xs leading-6 text-slate-500">{theme.description}</td>
                <td class="py-3 font-mono text-xs text-slate-600">{companyCount} 家</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="mt-8 text-base font-semibold text-slate-900">动态从哪里来？</h2>
      <p class="mt-3 text-sm leading-7 text-slate-600">
        每条动态都标注原始来源，主要跟踪下面这些官方渠道；涉及能力、版本与价格的信息，以厂商原文为准，并由编辑核对后发布。
      </p>

      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {DEFAULT_SOURCES.map((source) => (
          <li>
            <a href={source.href} target="_blank" rel="noreferrer" class="text-sm font-medium text-indigo-600 hover:underline">{source.name}</a>
          </li>
        ))}
      </ul>
    </section>
  </Shell>
</Root>

<script>
  import "../scripts/tabs";
  import "../scripts/list";
</script>
