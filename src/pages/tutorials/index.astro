---
import Root from "@/layouts/Root.astro";
import Shell from "@/layouts/Shell.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import PageGuide from "@/components/channel/PageGuide.astro";
import ColumnIcon from "@/components/tutorial/ColumnIcon.astro";
import { TUTORIAL_SOURCES } from "@/config/sources";
import { getAllPosts } from "@/modules/content";
import { tutorialsPage } from "@/modules/page-content";
import { getResolvedTutorialCatalogs } from "@/modules/tutorial";
import { getSiteUrl, siteConfig } from "@/shared/site";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";

const overview = tutorialsPage.intro;
const posts = await getAllPosts();
const catalogs = getResolvedTutorialCatalogs(posts);

// 章节名去掉「第一章：」前缀，只保留可扫读的主题词
const formatSectionLabel = (title: string) => title.replace(/^第[一二三四五六七八九十百零〇]+章[:：]\s*/, "");

const pageUrl = getSiteUrl("/tutorials/");
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: overview.title,
  description: tutorialsPage.seo.description,
  url: pageUrl,
  isPartOf: { "@type": "WebSite", name: siteConfig.name, url: getSiteUrl("/") },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: catalogs.map((catalog, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: catalog.title,
      description: catalog.description,
      url: getSiteUrl(`/tutorials/${catalog.id}/`),
    })),
  },
};

const faqJsonLd = overview.faqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: overview.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    }
  : null;

const enterCatalogClass = "accent-cta items-center gap-1 rounded-md bg-indigo-50 px-3 py-1.5 text-[13px] font-medium text-indigo-700 transition-colors group-hover:bg-indigo-600 group-hover:text-[color:var(--accent-on)]";
---
<Root title={tutorialsPage.seo.title} description={tutorialsPage.seo.description} path="/tutorials/">
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  {faqJsonLd ? <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} /> : null}

  <Shell selectedChannel="系列教程" mainClassName={widePageContainerClass}>
    <div class="space-y-5">
      <section class={pagePanelClass}>
        <PageHeader embedded eyebrow="TUTORIALS" title={overview.title} description={overview.description} />
      </section>

      <section aria-labelledby="column-list-title">
        <div class="mb-4 flex items-baseline justify-between gap-3">
          <h2 id="column-list-title" class="text-base font-semibold text-slate-900">系列目录</h2>
          <span class="font-mono text-xs text-slate-400">{catalogs.length} 个系列</span>
        </div>
        <ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {catalogs.map((catalog) => (
            <li class="min-w-0">
              <a
                href={`/tutorials/${catalog.id}/`}
                class="group flex h-full flex-col rounded-xl bg-surface p-5 ring-1 ring-slate-900/[0.07] transition-all duration-200 hover:-translate-y-1 hover:shadow-[0_18px_36px_-24px_rgba(17,24,39,0.3)] hover:ring-slate-900/[0.14] md:p-6"
              >
                <div class="flex items-start justify-between gap-3">
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-slate-100 ring-1 ring-slate-900/[0.06] transition-transform duration-200 group-hover:-rotate-6 group-hover:scale-105">
                    <span class="flex h-9 w-9 items-center justify-center rounded bg-surface text-slate-700 shadow-[0_0_0_1px_rgba(17,24,39,0.06)]">
                      <ColumnIcon name={catalog.icon} class="h-5 w-5" />
                    </span>
                  </span>
                  <div class="flex flex-col items-end gap-2">
                    <span class="font-mono text-[11px] tracking-[0.04em] text-slate-400">
                      {catalog.sections.length} 章节 · {catalog.articleCount} 篇
                    </span>
                    {/* 手机上卡片是整行宽，按钮挤在右上角很怪，改到底部展示 */}
                    <span class={`${enterCatalogClass} hidden md:inline-flex`}>
                      进入目录
                      <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
                    </span>
                  </div>
                </div>
                <h3 class="mt-3 text-lg font-bold text-slate-950 transition-colors group-hover:text-indigo-700 md:text-xl">{catalog.title}</h3>
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">{catalog.description}</p>
                <div class="mt-3 flex flex-wrap items-center gap-1.5">
                  {catalog.sections.slice(0, 3).map((section) => (
                    <span class="rounded bg-indigo-50 px-1.5 py-0.5 text-[11px] text-indigo-700">
                      {formatSectionLabel(section.title)}
                    </span>
                  ))}
                  {catalog.sections.length > 3 ? (
                    <span class="rounded bg-indigo-50 px-1.5 py-0.5 text-[11px] text-indigo-700">+{catalog.sections.length - 3}</span>
                  ) : null}
                </div>
                <span class={`${enterCatalogClass} mt-3 inline-flex self-start md:hidden`}>
                  进入目录
                  <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {overview.faqs?.length ? (
        <section aria-labelledby="columns-faq-title" class={pagePanelClass}>
          <div class="flex items-baseline gap-2">
            <h2 id="columns-faq-title" class="text-base font-semibold text-slate-900">常见问题</h2>
            <span class="font-mono text-xs text-slate-400">{overview.faqs.length} 个问答</span>
          </div>
          <dl class="mt-4 divide-y divide-slate-100">
            {overview.faqs.map((faq, index) => (
              <div class="py-4 first:pt-0 last:pb-0">
                <dt class="grid grid-cols-[1.75rem_1fr] gap-x-2 text-[15px] font-medium leading-6 text-slate-900">
                  <span aria-hidden="true" class="text-xs font-semibold leading-6 text-indigo-500">Q{index + 1}</span>
                  <span>{faq.question}</span>
                </dt>
                <dd class="mt-1 grid grid-cols-[1.75rem_1fr] gap-x-2 text-sm leading-6 text-slate-600">
                  <span aria-hidden="true" class="text-xs font-semibold leading-6 text-slate-300">A</span>
                  <span>{faq.answer}</span>
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ) : null}

      <PageGuide
        heading="系列教程适合怎么读？"
        description="系列教程由 NewHot 编辑与技术团队原创编写，参考厂商官方文档并在真实环境中验证，发布前逐篇人工校对。"
        sources={TUTORIAL_SOURCES}
        points={[
          "内容为原创撰写，不翻译、不搬运官方文档，也不直接摘录二手教程。",
          "涉及命令、配置与价格的部分，以厂商官方文档为准，并在文中标注出处。",
          "每个系列按章节顺序组织，先基础认知，再进入实践与项目落地。",
          "教程文章同时出现在普通文章列表里，目录页额外提供阅读路径。",
        ]}
        quote={{ text: "为开发者提供的资源，由开发者共同维护。", label: "MDN Web Docs", href: "https://developer.mozilla.org/" }}
      />
    </div>
  </Shell>
</Root>
