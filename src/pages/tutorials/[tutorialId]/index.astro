---
import Root from "@/layouts/Root.astro";
import Shell from "@/layouts/Shell.astro";
import PageGuide from "@/components/channel/PageGuide.astro";
import Icon from "@/components/ui/Icon.astro";
import { TUTORIAL_SOURCES } from "@/config/sources";
import { getAllPosts } from "@/modules/content";
import {
  getResolvedTutorialCatalogById,
  getResolvedTutorialCatalogs,
  tutorialTypeLabels,
  type ResolvedTutorialCatalog,
} from "@/modules/tutorial";
import { getSiteUrl, siteConfig } from "@/shared/site";
import { formatDate } from "@/shared/utils";
import { widePageContainerClass } from "@/shared/ui/classes";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return getResolvedTutorialCatalogs(posts).map((catalog) => ({
    params: { tutorialId: catalog.id },
    props: { id: catalog.id },
  }));
}

const { id } = Astro.props;
const posts = await getAllPosts();
const catalog = getResolvedTutorialCatalogById(posts, id);
if (!catalog) throw new Error(`教程系列不存在：${id}`);

const faqs = catalog.faqs ?? [];
const aboutItems = [{ title: "系列教程简介", description: catalog.description }, ...catalog.introBlocks];
const audience = catalog.introBlocks.find((block) => block.title.includes("适合"))?.description;
const introIcons = ["BookOpen", "Compass", "Users", "Route"] as const;

const metaRows = [
  { key: "channel", icon: "Radio", iconClass: "text-indigo-500", label: "频道", href: "/tutorials/", value: "系列教程" },
  { key: "type", icon: "Tag", iconClass: "text-rose-500", label: "类型", value: tutorialTypeLabels[catalog.type] },
  { key: "count", icon: "FileText", iconClass: "text-slate-500", label: "文章篇数", value: `${catalog.articleCount} 篇` },
  { key: "source", icon: "Building2", iconClass: "text-sky-500", label: "参考来源", value: catalog.source },
  { key: "author", icon: "UserRound", iconClass: "text-violet-500", label: "作者", value: catalog.author },
  {
    key: "published",
    icon: "CalendarClock",
    iconClass: "text-indigo-500",
    label: "发布时间",
    value: formatDate(catalog.publishedAt),
    datetime: catalog.publishedAt,
  },
  {
    key: "updated",
    icon: "CalendarCheck",
    iconClass: "text-emerald-500",
    label: "更新时间",
    value: formatDate(catalog.updatedAt ?? catalog.publishedAt),
    datetime: catalog.updatedAt ?? catalog.publishedAt,
  },
] as const;

const catalogArticles = catalog.sections.flatMap((section) => section.articles.filter((article) => !article.external));
const catalogUrl = getSiteUrl(`/tutorials/${catalog.id}/`);

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: catalog.title,
  description: catalog.description,
  url: catalogUrl,
  isPartOf: { "@type": "WebSite", name: siteConfig.name, url: getSiteUrl("/") },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: catalogArticles.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: article.post?.title ?? article.sidebarTitle,
      description: article.description,
      url: getSiteUrl(article.href),
    })),
  },
};

const faqJsonLd = faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    }
  : null;
---
<Root title={catalog.title} description={catalog.description} path={`/tutorials/${catalog.id}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  {faqJsonLd ? <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} /> : null}

  <Shell selectedChannel="系列教程" mainClassName={`${widePageContainerClass} bg-surface`}>
    <div class="flex justify-center gap-6 pt-3">
      <aside class="hidden w-[180px] shrink-0 min-[1400px]:block 2xl:w-[208px]">
        <div class="sticky top-[var(--site-article-sticky-offset)] z-10 bg-surface">
          <a
            href="/tutorials/"
            class="group flex items-center gap-1.5 text-[13px] font-medium leading-5 text-slate-600 transition-colors hover:text-indigo-600"
          >
            <Icon name="ArrowLeft" size={14} strokeWidth={2} class="transition-transform group-hover:-translate-x-0.5" />
            返回系列教程
          </a>
        </div>
        <div class="sticky top-[var(--site-article-sticky-offset)] mt-11">
          <div aria-hidden="true" class="h-[52px]"></div>
          <div class="mb-[22px] border-t border-slate-200/70"></div>
          <nav aria-label="系列教程信息">
            <ul class="space-y-3">
              {metaRows.map((row) => (
                <li class="min-w-0">
                  <span class="flex items-center gap-2.5 text-[11px] leading-4 text-slate-400">
                    <Icon name={row.icon} size={14} strokeWidth={1.9} class={`shrink-0 ${row.iconClass}`} />
                    {row.label}
                  </span>
                  <span class="mt-0.5 block pl-6 text-[13px] leading-5 text-slate-800">
                    {"href" in row && row.href ? (
                      <a href={row.href} class="transition-colors hover:text-indigo-500">{row.value}</a>
                    ) : "datetime" in row && row.datetime ? (
                      <time datetime={row.datetime}>{row.value}</time>
                    ) : (
                      row.value
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>

      <div class="w-full min-w-0 max-w-[860px]">
        <article>
          <nav
            aria-label="面包屑"
            class="mb-8 flex flex-wrap items-center gap-1.5 border-b border-slate-200/80 pb-3 text-[13px] leading-5 text-slate-500"
          >
            <a href="/tutorials/" class="transition-colors hover:text-indigo-500">系列教程</a>
            <span aria-hidden="true" class="text-slate-300">/</span>
            <span class="text-slate-400">{catalog.title}</span>
          </nav>

          <header>
            <div class="border-b border-slate-200/70 pb-4">
              <h1 class="text-[24px] font-bold leading-tight tracking-tight text-slate-950 md:text-[28px]">{catalog.title}</h1>
              <p class="mt-3 text-sm leading-7 text-slate-600">{catalog.description}</p>
            </div>
          </header>

          <section aria-labelledby="catalog-sections-title" class="mt-6">
            <h2 id="catalog-sections-title" class="text-base font-bold text-slate-950">这个系列包含哪些章节？</h2>
            <p class="mt-2 text-sm leading-6 text-slate-500">
              共 {catalog.sections.length} 个章节、{catalog.articleCount} 篇文章，按章节顺序编号；展开任一章节可以看到该章节下每篇文章的标题与简要说明。
            </p>

            <div class="mt-4 divide-y divide-slate-100">
              {catalog.sections.map((section) => (
                <details open>
                  <summary class="-mx-2 flex cursor-pointer list-none items-center gap-2 rounded-md px-2 py-2.5 transition-colors hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40 [&::-webkit-details-marker]:hidden">
                    <Icon
                      name="ChevronRight"
                      size={16}
                      strokeWidth={2}
                      class="shrink-0 text-slate-400 transition-transform [details[open]_&]:rotate-90"
                    />
                    <span class="min-w-0 flex-1 text-[15px] font-bold text-slate-950">{section.title}</span>
                    <span class="shrink-0 font-mono text-[11px] tracking-[0.04em] text-slate-400">{section.articles.length} 篇</span>
                  </summary>
                  {section.description ? (
                    <p class="pb-2 pl-6 pr-2 pt-0.5 text-xs leading-5 text-slate-500">{section.description}</p>
                  ) : null}
                  <ol class="mb-6 ml-6 mt-1 border-l border-slate-300 pl-4">
                    {section.articles.map((article, index) => (
                      <li>
                        <a
                          href={article.href}
                          target={article.external ? "_blank" : undefined}
                          rel={article.external ? "noreferrer" : undefined}
                          class="group/article -mx-2 block rounded-md transition-colors hover:bg-slate-100"
                        >
                          <span class="flex items-center gap-3 rounded-md px-2 py-2">
                            <span class="w-5 shrink-0 font-mono text-[11px] tabular-nums text-slate-300 transition-colors group-hover/article:text-indigo-500">
                              {String(index + 1).padStart(2, "0")}
                            </span>
                            <span class="min-w-0 flex-1 text-sm leading-6 text-slate-700 transition-colors group-hover/article:text-indigo-700">
                              {article.post?.title ?? article.sidebarTitle}
                            </span>
                            {article.badge ? (
                              <span class="shrink-0 rounded bg-indigo-50 px-2 py-0.5 text-[11px] text-indigo-700">{article.badge}</span>
                            ) : null}
                            <span aria-hidden="true" class="shrink-0 text-slate-300 transition-transform group-hover/article:translate-x-0.5 group-hover/article:text-indigo-500">
                              →
                            </span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </details>
              ))}
            </div>
          </section>

          {faqs.length > 0 ? (
            <section aria-labelledby="column-faq-title" class="mt-10 border-t border-slate-200 pt-6">
              <div class="flex items-baseline gap-2">
                <h2 id="column-faq-title" class="text-base font-bold text-slate-950">这个系列有哪些常见问题？</h2>
                <span class="text-xs text-slate-400">{faqs.length} 个问答</span>
              </div>
              <dl class="mt-2">
                {faqs.map((faq, index) => (
                  <div class="-mx-3 rounded-lg px-3 py-4 transition-colors hover:bg-slate-100">
                    <dt class="grid grid-cols-[1.75rem_1fr] gap-x-2 text-[15px] font-medium leading-6 text-slate-900">
                      <span aria-hidden="true" class="text-xs font-semibold leading-6 text-indigo-500">Q{index + 1}</span>
                      <span>{faq.question}</span>
                    </dt>
                    <dd class="mt-1 grid grid-cols-[1.75rem_1fr] gap-x-2 text-sm leading-6 text-slate-600">
                      <span aria-hidden="true" class="text-xs font-semibold leading-6 text-slate-300">A</span>
                      <span>{faq.answer}</span>
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          ) : null}

          <PageGuide
            panel={false}
            heading="这个系列适合谁读？"
            description={`${audience ?? catalog.description} 教程内容由编辑与技术团队原创编写，参考官方文档并在真实环境中验证，发布前逐篇人工校对。`}
            sources={TUTORIAL_SOURCES}
            points={[
              `共 ${catalog.sections.length} 个章节、${catalog.articleCount} 篇文章，按章节顺序编号。`,
              "章节内的操作步骤均在真实环境验证过，涉及版本与配置的说明以官方文档为准。",
              "内容为原创撰写，不翻译、不搬运官方文档，也不直接摘录二手教程。",
              "系列教程与普通文章共用同一批内容，目录页负责组织阅读顺序与上下文。",
            ]}
            quote={{ text: "为开发者提供的资源，由开发者共同维护。", label: "MDN Web Docs", href: "https://developer.mozilla.org/" }}
          />
        </article>
      </div>

      <aside class="hidden w-[clamp(220px,16vw,260px)] shrink-0 pt-16 xl:block">
        <div class="sticky top-[var(--site-article-sticky-offset)]">
          <h2 class="border-b border-slate-200/70 pb-8 text-[13px] font-medium leading-5 text-slate-950">关于这个系列</h2>
          <ol class="mt-[22px]">
            {aboutItems.map((block, index) => {
              const isLast = index === aboutItems.length - 1;
              return (
                <li class="relative flex gap-2.5 pb-4 last:pb-0">
                  {isLast ? null : <span aria-hidden="true" class="absolute bottom-0 left-[11px] top-6 w-px bg-slate-200"></span>}
                  <span class="relative flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full bg-indigo-50 text-indigo-700">
                    <Icon name={introIcons[index] ?? "Compass"} size={12} strokeWidth={2.2} />
                  </span>
                  <div class="min-w-0">
                    <h3 class="text-[13px] font-medium leading-[22px] text-slate-900">{block.title}</h3>
                    <p class="mt-0.5 text-xs leading-5 text-slate-500">{block.description}</p>
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      </aside>
    </div>
  </Shell>
</Root>
