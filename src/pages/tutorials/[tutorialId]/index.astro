---
import View from "@/views/tutorial-detail/index.astro";
import { getAllPosts } from "@/entities/article/model";
import { getResolvedTutorialCatalogs } from "@/entities/tutorial/model";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return getResolvedTutorialCatalogs(posts).map((catalog) => ({
    params: { tutorialId: catalog.id },
    props: { id: catalog.id },
  }));
}
---

<View {...Astro.props} />
