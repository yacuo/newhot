---
import View from "@/views/entity/index.astro";
import { topics } from "@/entities/channel/model";
import { companies } from "@/entities/vendor/model/model";

export function getStaticPaths() {
  return [
    ...topics.map((topic) => ({ params: { slug: topic.id }, props: { kind: "channel", id: topic.id } })),
    ...companies.map((company) => ({ params: { slug: company.id }, props: { kind: "company", id: company.id } })),
  ];
}
---

<View {...Astro.props} />
