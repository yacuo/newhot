---
import Root from "@/layouts/Root.astro";
import Shell from "@/layouts/Shell.astro";
import { themes, getTheme, getThemeSeo } from "@/modules/vendor/themes";
import { companies } from "@/modules/vendor/model";

export function getStaticPaths() {
  return themes.map((theme) => ({ params: { theme: theme.id }, props: { id: theme.id } }));
}

const { id } = Astro.props;
const theme = getTheme(id);
const groups = theme?.groups ?? [];
const related = companies.filter((company) => groups.some((group) => group.companyIds.includes(company.id)));
const title = theme?.name ?? "主题";
const seo = theme ? getThemeSeo(theme) : null;
---
<Root title={seo?.title ?? title} description={seo?.description ?? theme?.description ?? ""} path={`/themes/${id}/`}>
  <Shell selectedChannel="主题">
    <header class="mb-4 rounded-2xl bg-surface panel-glow p-5 md:p-7">
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">{title}</h1>
      {theme?.description ? <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-600">{theme.description}</p> : null}
      <p class="mt-3 text-xs text-slate-500">{related.length} 家公司</p>
    </header>

    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {related.map((company) => (
        <a
          href={`/${company.id}/`}
          data-company-card
          class="rounded-xl bg-surface p-4 ring-1 ring-slate-900/[0.06] transition hover:ring-indigo-200"
        >
          <p class="text-[15px] font-semibold text-slate-900">{company.name}</p>
          <p class="mt-1 text-[13px] leading-6 text-slate-500">{company.products.length} 个产品</p>
        </a>
      ))}
    </div>
  </Shell>
</Root>
