---
import Root from "@/layouts/Root.astro";
import Shell from "@/layouts/Shell.astro";
import ChannelPanel from "@/components/channel/ChannelPanel.astro";
import PageGuide from "@/components/channel/PageGuide.astro";
import { readFeedMeta } from "@/modules/content";
import { themesPage } from "@/modules/page-content/themes";
import { sharedPage } from "@/modules/page-content/shared";
import { buildThemeListing, themeHref, themes } from "@/modules/vendor/themes";
import { getSiteUrl, siteConfig } from "@/shared/site";
import { formatMonthDay } from "@/shared/utils";
import { widePageContainerClass } from "@/shared/ui/classes";

const meta = readFeedMeta();
if (!meta) throw new Error("meta.json 未生成");

const blocks = themes.map((theme) => {
  const listing = buildThemeListing(theme, meta.companies);
  const seen = new Set<string>();
  const logos: string[] = [];

  for (const summary of listing.summaries) {
    const logo = summary.company.logo;
    if (!logo || seen.has(logo)) continue;
    seen.add(logo);
    logos.push(logo);
    if (logos.length === 7) break;
  }

  const latest = listing.summaries.reduce<string | null>(
    (value, summary) => (summary.lastUpdated && (!value || summary.lastUpdated > value) ? summary.lastUpdated : value),
    null,
  );

  return {
    id: theme.id,
    name: theme.name,
    description: theme.description,
    companyCount: listing.summaries.length,
    articleCount: listing.summaries.reduce((total, summary) => total + summary.articleCount, 0),
    latest,
    logos,
    sections: listing.sections,
  };
});

const description = themesPage.seo.description;
const guide = sharedPage.guide.theme;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: themesPage.seo.title,
  description,
  url: getSiteUrl("/themes/"),
  inLanguage: siteConfig.language,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: blocks.length,
    itemListElement: blocks.map((block, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: block.name,
      description: block.description,
      url: getSiteUrl(themeHref(block.id)),
    })),
  },
};

---
<Root
  title={themesPage.seo.title}
  description={themesPage.seo.description}
  path={themesPage.seo.path}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Shell selectedChannel={guide.panelTitle} mainClassName={widePageContainerClass}>
    <ChannelPanel
      title={guide.panelTitle}
      eyebrow={guide.panelEyebrow}
      description={themesPage.seo.description}
    />

    <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {blocks.map((block) => (
        <a
          href={themeHref(block.id)}
          class="group flex flex-col rounded-2xl bg-surface p-5 ring-1 ring-slate-900/[0.07] transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-50 hover:ring-slate-900/[0.14] hover:shadow-[0_12px_28px_-20px_rgba(17,24,39,0.25)]"
        >
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="text-[16px] font-semibold tracking-[-0.01em] text-slate-950 transition-colors group-hover:text-indigo-600">
              {block.name}
            </h2>
            <span class="shrink-0 font-mono text-[11px] tabular-nums text-slate-400">{block.companyCount} 家公司</span>
          </div>
          <p class="mt-2 line-clamp-2 text-[13px] leading-6 text-slate-500">{block.description}</p>
          <div class="mt-4 flex items-center gap-1.5">
            {block.logos.map((logo) => (
              <img
                src={logo}
                alt={`${block.name} 收录公司标志`}
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                class="h-5 w-5 rounded-full bg-white object-contain ring-1 ring-slate-900/[0.05]"
              />
            ))}
          </div>
          <div class="mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-1 pt-4 font-mono text-[11px] text-slate-400">
            <span>
              {block.articleCount} 篇动态{block.latest ? ` · 更新至 ${formatMonthDay(block.latest)}` : ""}
            </span>
            <span class="text-indigo-600 transition-colors group-hover:text-indigo-700">查看主题 →</span>
          </div>
        </a>
      ))}
    </div>

    <PageGuide
      heading={guide.heading}
      description={guide.description}
    />
  </Shell>
</Root>
