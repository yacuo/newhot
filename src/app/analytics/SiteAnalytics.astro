---
/**
 * 流量统计与站长验证占位组件。
 *
 * - 三个 ID 都在 `.env` 里配置，留空则整段不渲染；
 * - 自动跳过 `astro dev` 和预览构建（SITE_NOINDEX=1），避免测试流量混进报表；
 * - 百度统计用页面里直接写死的 script 标签，不做 JS 动态插入，保证统计脚本一定被加载。
 */
import { analyticsConfig } from "@/shared/config/analytics.config";

const enabled = !import.meta.env.DEV && process.env.SITE_NOINDEX !== "1";

const gaId = analyticsConfig.googleAnalyticsId;
const baiduId = analyticsConfig.baiduTongjiId;
const bingVerification = analyticsConfig.bingVerification;

const gaEnabled = enabled && /^G-[A-Z0-9]+$/i.test(gaId);
const baiduEnabled = enabled && baiduId.length > 0;
const bingEnabled = enabled && bingVerification.length > 0;

const baiduSrc = `https://hm.baidu.com/hm.js?${baiduId}`;
---

{bingEnabled ? <meta name="msvalidate.01" content={bingVerification} /> : null}

{gaEnabled ? (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
) : null}

{baiduEnabled ? (
  <>
    <script is:inline>window._hmt = window._hmt || [];</script>
    <script is:inline async src={baiduSrc}></script>
  </>
) : null}
