---
import BrandLogo from "./BrandLogo.astro";
import Icon from "@/shared/ui/Icon.astro";

type Props = {
  showMobileMenu?: boolean;
  headerInnerClassName?: string;
};

const { showMobileMenu = false, headerInnerClassName } = Astro.props;
---
<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-surface/95 backdrop-blur lg:hidden">
  <div
    data-site-header-inner
    class={`relative mx-auto flex w-full min-h-[64px] items-center justify-between gap-4 pl-5 pr-5 lg:hidden ${headerInnerClassName ?? ""}`}
  >
    <BrandLogo />

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <button
        type="button"
        data-mobile-search-toggle
        aria-label="打开搜索"
        aria-expanded="false"
        class="mobile-search-toggle inline-flex h-9 w-9 items-center justify-center text-slate-700 transition hover:text-indigo-500 lg:hidden"
      >
        <Icon name="Search" size={20} strokeWidth={1.6} />
      </button>
      {showMobileMenu ? (
        <button
          type="button"
          data-mobile-drawer-toggle
          aria-label="打开导航菜单"
          aria-expanded="false"
          class="inline-flex h-9 w-9 items-center justify-center text-slate-700 transition hover:text-indigo-500"
        >
          <Icon name="EllipsisVertical" size={20} strokeWidth={1.9} />
        </button>
      ) : null}
    </div>
  </div>
</header>

<div
  data-mobile-search-panel
  hidden
  class="mobile-search-panel fixed inset-x-0 top-[var(--site-header-height)] z-50 border-t border-slate-200 bg-surface p-4 shadow-[0_18px_40px_rgba(15,23,42,0.18)] lg:hidden"
>
  <div class="mb-3 flex items-center justify-between gap-3">
    <span class="text-sm font-semibold text-slate-800">搜索文章</span>
    <button
      type="button"
      data-mobile-search-close
      class="rounded-full px-3 py-1.5 text-sm text-slate-500 transition hover:bg-slate-100 hover:text-slate-800"
    >
      取消
    </button>
  </div>

  <div class="relative block w-full">
    <label class="sr-only" for="site-search-mobile">搜索文章</label>
    <input
      id="site-search-mobile"
      data-search-input
      type="search"
      placeholder="搜索标题和正文"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      class="site-search-input h-10 w-full rounded-full border border-slate-200 bg-surface px-4 pr-10 text-[15px] leading-10 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
    />
    <div data-search-results></div>
  </div>
</div>
