---
---
<div class="relative" data-accent-picker>
  <button
    type="button"
    data-accent-toggle
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="主题色：电蓝"
    title="主题色：电蓝"
    class="inline-flex h-7 items-center gap-1.5 rounded px-1.5 text-[11px] text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900"
  >
    <span data-accent-dot class="h-2.5 w-2.5 flex-none rounded-full ring-1 ring-slate-900/10" style="background-color:#3b5bff"></span>
    <span>主题色</span>
  </button>
  <div
    data-accent-menu
    role="menu"
    aria-label="选择主题色"
    hidden
    class="absolute bottom-full left-1/2 z-50 mb-2 w-36 -translate-x-1/2 rounded-xl bg-surface p-1 shadow-[0_12px_32px_-16px_rgba(15,23,42,0.35)] ring-1 ring-slate-900/10"
  ></div>
</div>
