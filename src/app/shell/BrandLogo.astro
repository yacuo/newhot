---
import { siteConfig } from "@/shared/config/site";

type Props = { href?: string };
const { href = "/" } = Astro.props;
const wordmark = siteConfig.wordmark;
---
<a
  href={href}
  data-nav-link
  aria-label={siteConfig.name}
  class="brand-wordmark group inline-flex shrink-0 items-center gap-[3px] text-[26px] font-extrabold leading-none tracking-[-0.02em]"
>
  {wordmark.map((part) => <span>{part}</span>)}
</a>
