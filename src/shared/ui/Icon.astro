---
import type { IconName } from "./icon-data";

type Props = {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
};

const { name, size = 24, strokeWidth = 2, class: className } = Astro.props;
const kebab = name.replace(/([a-z0-9])([A-Z])/g, "$1-$2").replace(/([A-Z])([A-Z][a-z])/g, "$1-$2").toLowerCase();
const iconClass = `lucide lucide-${kebab}${className ? ` ${className}` : ""}`;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={iconClass}
  aria-hidden="true"
>
  <use href={`/icons.svg#i-${kebab}`} />
</svg>
