---
import Root from "@/app/layouts/Root.astro";
import Shell from "@/app/layouts/Shell.astro";
import AgentShell from "@/entities/agent/ui/AgentShell.astro";
import Badge from "@/entities/agent/ui/Badge.astro";
import CopyButton from "@/entities/agent/ui/CopyButton.astro";
import CodeBlock from "@/entities/agent/ui/CodeBlock.astro";
import InlineText from "@/shared/ui/InlineText.astro";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";
import { buildBreadcrumbJsonLd, buildTechArticleJsonLd } from "@/shared/seo/jsonld";
import { agentPage } from "@/entities/page-content/model";

const { skill } = agentPage;

const articleJsonLd = buildTechArticleJsonLd({
  headline: skill.seo.title,
  description: skill.seo.description,
  path: skill.seo.path,
  about: ["Agent Skill", "SKILL.md"],
});

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "首页", href: "/" },
  { name: "Agent 接入", href: "/agent/" },
  { name: "Agent Skill", href: skill.seo.path },
]);
---

<Root title={skill.seo.title} description={skill.seo.description} path={skill.seo.path}>
  <Shell mainClassName={widePageContainerClass} selectedChannel="Agent 接入">
    <AgentShell title={skill.header.title} description={skill.header.description}>
      <section class={pagePanelClass}>
        <div class="flex flex-wrap gap-2">
          {skill.badges.map((badge) => <Badge label={badge.label} tone={badge.tone} />)}
        </div>
        <p class="mt-4 text-sm leading-7 text-slate-700">
          <InlineText text={skill.intro} />
        </p>
      </section>

      <section class={pagePanelClass}>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-semibold tracking-tight text-slate-950">{skill.steps.title}</h2>
        </div>

        <ol class="mt-5 divide-y divide-slate-100">
          <li class="py-5 first:pt-0">
            <h3 class="text-base font-semibold tracking-tight text-slate-950">{skill.steps.prompt.title}</h3>
            <p class="mt-2 text-[13px] leading-6 text-slate-500">
              {skill.steps.prompt.note}
            </p>
            <div class="mt-3">
              <CodeBlock code={skill.steps.prompt.code} label={skill.steps.prompt.codeLabel} />
            </div>
          </li>

          <li class="py-5">
            <h3 class="text-base font-semibold tracking-tight text-slate-950">{skill.steps.newSession.title}</h3>
            <p class="mt-2 text-[13px] leading-6 text-slate-500">
              {skill.steps.newSession.note}
            </p>
          </li>

          <li class="py-5 last:pb-0">
            <h3 class="text-base font-semibold tracking-tight text-slate-950">{skill.steps.ask.title}</h3>
            <div class="mt-3 flex flex-wrap items-center gap-2 rounded-xl bg-slate-50 px-4 py-3">
              <span class="text-[13px] text-slate-700">{skill.steps.ask.text}</span>
              <CopyButton text={skill.steps.ask.text} />
            </div>
            <p class="mt-2 text-[13px] leading-6 text-slate-500">
              {skill.steps.ask.note}
            </p>
          </li>
        </ol>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{skill.prompts.title}</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          {skill.prompts.description}
        </p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          {skill.prompts.items.map((prompt) => (
            <div class="flex items-center justify-between gap-3 rounded-xl bg-slate-50 px-4 py-3">
              <span class="text-[13px] leading-6 text-slate-700">{prompt}</span>
              <CopyButton text={prompt} />
            </div>
          ))}
        </div>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{skill.manual.title}</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          {skill.manual.description}
        </p>
        {skill.manual.entries.map((entry) => (
          <>
            <p class="mt-4 text-[11px] font-semibold text-slate-500">{entry.label}</p>
            <div class="mt-2">
              <CodeBlock code={entry.code} lang="bash" label={entry.codeLabel} />
            </div>
          </>
        ))}
        <p class="mt-3 text-xs leading-6 text-slate-500">
          <InlineText text={skill.manual.footnote} />
        </p>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{skill.troubleshooting.title}</h2>
        <ol class="mt-3 space-y-2.5 text-sm leading-7 text-slate-600">
          {skill.troubleshooting.items.map((item) => (
            <li>
              <span class="font-medium text-slate-900">{item.label}</span><InlineText text={item.text} />
            </li>
          ))}
        </ol>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{skill.alternatives.title}</h2>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-slate-600">
          {skill.alternatives.items.map((item) => (
            <li><InlineText text={item} /></li>
          ))}
        </ul>
        <p class="mt-3 text-xs leading-6 text-slate-500">
          <InlineText text={skill.alternatives.note} />
        </p>
      </section>
    </AgentShell>
  </Shell>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Root>
