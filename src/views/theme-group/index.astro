---
import Root from "@/app/layouts/Root.astro";
import Shell from "@/app/layouts/Shell.astro";
import ChannelPanel from "@/entities/channel/ui/ChannelPanel.astro";
import CompanyRankRow from "@/entities/vendor/ui/CompanyRankRow.astro";
import PageGuide from "@/entities/channel/ui/PageGuide.astro";
import { buildThemeListing, getTheme, themeGroupHref, themeHref, themes } from "@/entities/vendor/model/themes";
import { readFeedMeta } from "@/entities/article/model";
import { sharedPage } from "@/entities/page-content/model/shared";
import { formatMonthDay } from "@/shared/lib/utils";
import { widePageContainerClass, pagePanelClass } from "@/shared/ui/classes";


const { themeId, groupId } = Astro.props;
const theme = getTheme(themeId);
if (!theme) throw new Error(`主题不存在：${themeId}`);

const meta = readFeedMeta();
if (!meta) throw new Error("meta.json 未生成");
const guide = sharedPage.guide.theme;

const listing = buildThemeListing(theme, meta.companies);
const section = listing.sections.find((entry) => entry.id === groupId);
if (!section) throw new Error(`主题分组不存在：${themeId}/${groupId}`);

const articleCount = section.summaries.reduce((total, summary) => total + summary.articleCount, 0);
const latest = section.summaries.reduce<string | null>(
  (value, summary) => (summary.lastUpdated && (!value || summary.lastUpdated > value) ? summary.lastUpdated : value),
  null,
);
const names = section.summaries.map((summary) => summary.company.name);

// 标题按公司名拼，超长就少放几个名字，保证整条 title 不超过 60 字（含站名后缀）
const pickTitle = (count: number) => {
  const top = names.slice(0, count);
  return `${section.label}：${top.join("、")}${names.length > top.length ? ` 等 ${names.length} 家公司` : ""}`;
};
let title = pickTitle(3);
if (title.length > 50) title = pickTitle(2);
if (title.length > 50) title = `${section.label}：${theme.name}下的 ${names.length} 家公司`;

let description = `${theme.name}主题的${section.label}分类，覆盖${names.slice(0, 6).join("、")}${names.length > 6 ? ` 等 ${names.length}` : ""} 家公司，共 ${articleCount} 篇官方动态，记录产品能力、版本更新、价格与授权变化。`;
if (description.length > 160) {
  description = `${theme.name}主题的${section.label}分类，覆盖${names.slice(0, 4).join("、")} 等 ${names.length} 家公司，共 ${articleCount} 篇官方动态，记录产品能力、版本更新、价格与授权变化。`;
}

const tabs = [
  { id: "all", label: "全部", href: themeHref(theme.id) },
  ...listing.sections.map((entry) => ({
    id: entry.id,
    label: entry.label,
    href: themeGroupHref(theme.id, entry.id),
    active: entry.id === section.id,
  })),
];
---
<Root title={title} description={description} path={themeGroupHref(theme.id, section.id)}>
  <Shell selectedChannel={guide.panelTitle} mainClassName={widePageContainerClass}>
    <ChannelPanel
      title={`${theme.name} · ${section.label}`}
      eyebrow={theme.eyebrow}
      description={description}
      tabs={tabs}
    />

    <section class={`mt-5 ${pagePanelClass}`}>
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-base font-semibold text-slate-900">公司列表</h2>
        <p class="shrink-0 font-mono text-[11px] tracking-[0.04em] text-slate-400">
          {`${section.summaries.length} 家公司 · ${articleCount} 篇动态${latest ? ` · 更新至 ${formatMonthDay(latest)}` : ""}`}
        </p>
      </div>

      <ul class="mt-5 divide-y divide-slate-100" data-theme-section={section.id}>
        {section.summaries.map((summary, index) => (
          <CompanyRankRow
            summary={summary}
            rank={index + 1}
            maxCount={Math.max(...section.summaries.map((item) => item.articleCount), 1)}
          />
        ))}
      </ul>
    </section>

    <PageGuide
      heading={guide.heading}
      description={guide.description}
    />
  </Shell>
</Root>
