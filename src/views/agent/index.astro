---
import Root from "@/app/layouts/Root.astro";
import Shell from "@/app/layouts/Shell.astro";
import AgentShell from "@/entities/agent/ui/AgentShell.astro";
import Badge from "@/entities/agent/ui/Badge.astro";
import InlineText from "@/shared/ui/InlineText.astro";
import Icon from "@/shared/ui/Icon.astro";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";
import { getSiteUrl, siteConfig } from "@/shared/config/site";
import { buildBreadcrumbJsonLd } from "@/shared/seo/jsonld";
import { agentPage } from "@/entities/page-content/model";

const { overview } = agentPage;
const { choices } = overview;

const seoTitle = overview.seo.title;
const seoDescription = overview.seo.description;

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: seoTitle,
  description: seoDescription,
  url: getSiteUrl("/agent/"),
  inLanguage: siteConfig.language,
  isPartOf: { "@type": "WebSite", name: siteConfig.name, url: getSiteUrl("/") },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: choices.map((choice, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: choice.name,
      url: getSiteUrl(choice.href),
    })),
  },
};

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "首页", href: "/" },
  { name: "Agent 接入", href: "/agent/" },
]);
---

<Root title={overview.seo.title} description={overview.seo.description} path={overview.seo.path}>
  <Shell mainClassName={widePageContainerClass} selectedChannel="Agent 接入">
    <AgentShell title={overview.header.title} description={overview.header.description}>
      <section class={pagePanelClass}>
        <div class="flex flex-wrap gap-2">
          {overview.badges.map((badge) => <Badge label={badge.label} tone={badge.tone} />)}
        </div>
        <p class="mt-4 text-sm leading-7 text-slate-700">
          <InlineText text={overview.intro} />
        </p>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{overview.choicesTitle}</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {choices.map((choice) => (
            <a
              href={choice.href}
              class="group rounded-xl bg-slate-50 p-4 transition-colors hover:bg-white hover:ring-1 hover:ring-slate-900/10"
            >
              <div class="flex items-center justify-between gap-2">
                <p class="text-sm font-semibold text-slate-950 group-hover:text-indigo-600">{choice.name}</p>
                <Icon
                  name="ArrowRight"
                  size={14}
                  class="text-slate-300 transition-transform group-hover:translate-x-0.5 group-hover:text-slate-500"
                />
              </div>
              <p class="mt-1.5 text-[13px] leading-6 text-slate-500">{choice.description}</p>
            </a>
          ))}
        </div>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{overview.gettingStarted.title}</h2>
        <ol class="mt-3 space-y-2 text-sm leading-7 text-slate-600">
          {overview.gettingStarted.items.map((item) => (
            <li><InlineText text={item} /></li>
          ))}
        </ol>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{overview.resources.title}</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          {overview.resources.description}
        </p>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-slate-600">
          {overview.resources.items.map((item) => (
            <li>
              <a
                class="font-mono text-[12px] text-indigo-600 hover:underline"
                href={item.href}
                target={item.href.startsWith("http") ? "_blank" : undefined}
                rel={item.href.startsWith("http") ? "noreferrer" : undefined}
              >{item.label}</a>
              <span class="ml-2 text-slate-500">{item.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{overview.specs.title}</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          {overview.specs.description}
        </p>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-slate-600">
          {overview.specs.items.map((item) => (
            <li>
              <a class="text-indigo-600 hover:underline" href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
              <span class="ml-2 text-slate-500">{item.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class={pagePanelClass}>
        <h2 class="text-lg font-semibold tracking-tight text-slate-950">{overview.troubleshooting.title}</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">{overview.troubleshooting.description}</p>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-slate-600">
          {overview.troubleshooting.items.map((item) => (
            <li>
              <span class="font-medium text-slate-900">{item.label}</span>：<InlineText text={item.text} />
            </li>
          ))}
        </ul>
      </section>
    </AgentShell>
  </Shell>
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Root>
