---
import Root from "@/app/layouts/Root.astro";
import Shell from "@/app/layouts/Shell.astro";
import PageHeader from "@/shared/ui/PageHeader.astro";
import { topics } from "@/entities/channel/model";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";
import { siteConfig } from "@/shared/config/site";

const description = `${siteConfig.name} 全部频道：按主题浏览 AI 大模型、AI 编程、AI 办公、AI 创作与故障排查的最新内容。`;
---
<Root title="全部频道" description={description} path="/topics/">
  <Shell mainClassName={widePageContainerClass}>
    <div class="space-y-5">
      <PageHeader eyebrow="TOPICS" title="全部频道" description={description} stats={`${topics.length} 个频道`} />

      <div class="grid gap-3 md:grid-cols-2">
        {topics.map((topic) => (
          <a href={`/${topic.id}/`} class={`${pagePanelClass} transition hover:ring-2 hover:ring-indigo-200`}>
            <h2 class="text-base font-semibold text-slate-950">{topic.label}</h2>
            <p class="mt-2 text-sm leading-7 text-slate-500">{topic.description}</p>
            <p class="mt-3 text-xs text-slate-400">{topic.subcategories.length} 个分类</p>
          </a>
        ))}
      </div>
    </div>
  </Shell>
</Root>
