---
import Root from "@/app/layouts/Root.astro";
import Shell from "@/app/layouts/Shell.astro";
import PageHeader from "@/shared/ui/PageHeader.astro";
import LegalSections from "@/shared/ui/LegalSections.astro";
import { siteConfig } from "@/shared/config/site";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";
import { contributePage } from "@/entities/page-content/model";

const { seo, header, sections, actions } = contributePage;

/** 内容里用 repository 指代源码仓库，避免把地址写死在两份数据里 */
const resolveHref = (href: string) => (href === "repository" ? siteConfig.repository : href);
---

<Root title={seo.title} description={seo.description} path={seo.path}>
  <Shell mainClassName={widePageContainerClass}>
    <div class="space-y-5">
      <PageHeader eyebrow={header.eyebrow} title={header.title} description={header.description} />

      <article class={pagePanelClass}>
        <LegalSections sections={sections} />

        <div class="mt-8 flex flex-wrap gap-3 border-t border-slate-200 pt-6">
          {actions.map((action) => {
            const href = resolveHref(action.href);
            return (
              <a
                href={href}
                target={href.startsWith("http") ? "_blank" : undefined}
                rel={href.startsWith("http") ? "noreferrer" : undefined}
                class="inline-flex h-9 items-center rounded border border-indigo-200 bg-surface px-4 text-sm font-medium text-indigo-700 transition hover:border-indigo-300 hover:bg-indigo-50"
              >{action.label}</a>
            );
          })}
        </div>
      </article>
    </div>
  </Shell>
</Root>
