---
import Root from "@/app/layouts/Root.astro";
import Shell from "@/app/layouts/Shell.astro";
import PageHeader from "@/shared/ui/PageHeader.astro";
import LegalSections from "@/shared/ui/LegalSections.astro";
import { legalPage } from "@/entities/page-content/model/legal";
import { pagePanelClass, widePageContainerClass } from "@/shared/ui/classes";

const { seo, updated, sections } = legalPage.privacy;
---
<Root title={seo.title} description={seo.description} path={seo.path}>
  <Shell mainClassName={widePageContainerClass}>
    <div class="space-y-5">
      <PageHeader eyebrow="PRIVACY" title={seo.title} description={`最后更新：${updated}`} />

      <article class={pagePanelClass}>
        <LegalSections sections={sections} />

        <div class="mt-8 flex flex-wrap gap-4 border-t border-slate-200 pt-6 text-sm">
          <a href="/cookies/" class="font-medium text-indigo-600 hover:underline">Cookie 政策</a>
          <a href="/do-not-sell/" class="font-medium text-indigo-600 hover:underline">不出售或共享个人信息</a>
          <a href="/terms/" class="font-medium text-indigo-600 hover:underline">服务条款</a>
        </div>
      </article>
    </div>
  </Shell>
</Root>
