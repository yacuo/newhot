---
import Root from "@/app/layouts/Root.astro";
import Shell from "@/app/layouts/Shell.astro";
import PageHeader from "@/shared/ui/PageHeader.astro";
import GithubIcon from "@/shared/ui/GithubIcon.astro";
import { openSourcePage } from "@/entities/page-content/model";

const formatStars = (stars?: number) => (stars ? (stars >= 1000 ? `${(stars / 1000).toFixed(1)}k` : String(stars)) : null);
---
<Root title={openSourcePage.seo.title} description={openSourcePage.seo.description} path="/open-source/">
  <Shell selectedChannel="开源">
    <div class="open-source-page space-y-12 md:space-y-16">
      <section class="open-source-hero rounded-md px-5 py-5 md:px-8 md:py-6">
        <div class="mx-auto max-w-[1440px]">
          <PageHeader eyebrow="OPEN SOURCE" title={openSourcePage.hero.title} description={openSourcePage.hero.description}>
            <div class="flex flex-wrap gap-3">
              {openSourcePage.hero.actions.map((action) => (
                <a
                  href={action.href}
                  target={action.external ? "_blank" : undefined}
                  rel={action.external ? "noreferrer" : undefined}
                  class="open-source-hero-button"
                >
                  {action.label.includes("GitHub") ? <GithubIcon class="h-4 w-4" /> : null}
                  <span>{action.label}</span>
                </a>
              ))}
            </div>
          </PageHeader>
        </div>
      </section>

      <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        {openSourcePage.stats.map((item) => (
          <div class="open-source-stat-card rounded-md p-4 text-center md:p-5">
            <div class="text-2xl font-bold text-slate-950">{item.value}</div>
            <div class="mt-2 text-sm text-slate-500">{item.label}</div>
          </div>
        ))}
      </section>

      <section>
        <div class="mb-6 text-center">
          <p class="text-sm font-semibold text-indigo-600">Projects</p>
          <h2 class="mt-2 text-2xl font-bold text-slate-950">{openSourcePage.projectsSection.title}</h2>
          <p class="mt-3 text-sm leading-7 text-slate-500">{openSourcePage.projectsSection.description}</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {openSourcePage.projects.map((project, index) => {
            const stars = formatStars(project.stars);
            return (
              <article class="open-source-project-card">
                <div class="flex items-center justify-between gap-3">
                  <span class="font-mono text-xs font-semibold tracking-[0.18em] text-slate-400">{String(index + 1).padStart(2, "0")}</span>
                  <span class="open-source-category-pill">{project.category}</span>
                </div>
                <h3 class="mt-5 text-xl font-bold tracking-tight text-slate-950 md:text-[22px]">{project.name}</h3>
                <p class="mt-1.5 font-mono text-xs text-slate-400">{project.repo}</p>
                <p class="mt-4 text-sm leading-7 text-slate-500">{project.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {project.stack.map((item) => (
                    <span class="open-source-stack-tag">{item}</span>
                  ))}
                </div>
                <div class="mt-auto">
                  <div class="mt-6 flex items-center justify-between gap-3 border-t border-slate-200 pt-4">
                    <span class="text-sm font-semibold text-emerald-600">{project.status}</span>
                    {stars ? <span class="text-sm font-semibold text-amber-500">★ {stars}</span> : null}
                  </div>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {project.links.github ? <a href={project.links.github} target="_blank" rel="noreferrer" class="open-source-link"><GithubIcon class="h-4 w-4" /><span>GitHub</span></a> : null}
                    {project.links.docs ? <a href={project.links.docs} target="_blank" rel="noreferrer" class="open-source-link"><span>文档</span></a> : null}
                    {project.links.demo ? <a href={project.links.demo} target="_blank" rel="noreferrer" class="open-source-link"><span>官网</span></a> : null}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <section class="open-source-contribution rounded-md p-6 text-center md:p-8">
        <h2 class="text-2xl font-bold text-slate-950">{openSourcePage.contribution.title}</h2>
        <p class="mt-3 text-sm leading-7 text-slate-500 md:text-base">{openSourcePage.contribution.description}</p>
      </section>
    </div>
  </Shell>
</Root>
