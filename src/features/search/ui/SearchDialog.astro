---
---
<dialog
  data-search-dialog
  class="fixed inset-0 m-0 h-full w-full max-w-none bg-transparent p-0 backdrop:bg-slate-950/35 backdrop:backdrop-blur-sm"
>
  <div class="px-6 py-16">
    <div class="mx-auto w-full max-w-5xl rounded-2xl bg-surface p-5 shadow-[0_24px_80px_rgba(15,23,42,0.28)]">
      <div class="mb-4 flex items-center justify-between gap-4">
        <div>
          <p class="text-base font-semibold text-slate-950">搜索文章</p>
          <p class="mt-1 text-sm text-slate-500">输入关键词，快速查找标题和正文内容。</p>
        </div>
        <button
          type="button"
          data-search-close
          class="rounded-full px-3 py-1.5 text-sm text-slate-500 transition hover:bg-slate-100 hover:text-slate-800"
        >
          关闭
        </button>
      </div>

      <label class="sr-only" for="site-search-desktop">搜索文章</label>
      <input
        id="site-search-desktop"
        data-search-input
        type="search"
        placeholder="搜索标题和正文"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        class="site-search-input h-11 w-full rounded-full border border-slate-200 bg-surface px-5 pr-12 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
      />

      <div data-search-results></div>
    </div>
  </div>
</dialog>
