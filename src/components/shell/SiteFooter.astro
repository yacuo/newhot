---
import GithubIcon from "@/components/ui/GithubIcon.astro";
import { siteConfig } from "@/shared/site";

const footerLinks = [
  { label: "全部频道", href: "/topics/" },
  { label: "关于我们", href: "/about/" },
  { label: "联系我们", href: "/contact/" },
  { label: "投稿指南", href: "/contribute/" },
  { label: "Agent 接入", href: "/agent/" },
  { label: "RSS", href: "/feed.xml" },
  { label: "隐私政策", href: "/privacy/" },
  { label: "Cookie 政策", href: "/cookies/" },
  { label: "不出售或共享个人信息", href: "/do-not-sell/" },
  { label: "服务条款", href: "/terms/" },
  { label: "站点地图", href: "/sitemap.xml" },
  { label: "NewHot 主站", href: "https://newhot.org" },
  { label: "GitHub", href: siteConfig.repository },
];

const linkClassName =
  "text-[13px] leading-6 text-slate-500 transition-colors duration-150 hover:text-slate-950";
---
<footer class="border-t border-slate-200/60 bg-surface">
  <div class="mx-auto w-full max-w-[1200px] px-5 pb-8 pt-10 min-[1800px]:max-w-[1320px] min-[1920px]:max-w-[1440px] xl:px-10">
    <div class="flex flex-col gap-7 md:flex-row md:items-start md:justify-between md:gap-8">
      <div class="max-w-[300px]">
        <a href="/" data-nav-link class="inline-flex items-baseline gap-2">
          <span class="text-[15px] font-semibold tracking-tight text-slate-950">{siteConfig.name}</span>
          <span class="text-[10px] font-medium uppercase tracking-[0.18em] text-slate-400">
            AI Intelligence
          </span>
        </a>
        <p class="mt-2 max-w-xs text-[13px] leading-6 text-slate-500">{siteConfig.description}</p>
      </div>

      <nav aria-label="页脚导航" class="flex flex-wrap items-center gap-x-5 gap-y-2 md:justify-end">
        {footerLinks.map((link) =>
          link.href.startsWith("http") ? (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              aria-label={link.label === "GitHub" ? "GitHub 仓库（在新标签页打开）" : undefined}
              class={link.label === "GitHub" ? "text-slate-400 transition-colors duration-150 hover:text-slate-950" : linkClassName}
            >
              {link.label === "GitHub" ? <GithubIcon class="h-[18px] w-[18px]" /> : link.label}
            </a>
          ) : (
            <a href={link.href} data-nav-link class={linkClassName}>
              {link.label}
            </a>
          ),
        )}
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-1.5 border-t border-slate-100 pt-4 text-[11px] leading-5 text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex flex-wrap items-center gap-x-1.5">
        <span>{siteConfig.copyright}</span>
        <span aria-hidden="true">·</span>
        <span>
          模板来自 <a href="https://newhot.org" target="_blank" rel="noopener" class="text-slate-500 underline-offset-2 transition-colors hover:text-slate-900 hover:underline">NewHot</a>
        </span>
      </p>
      <p>内容仅供参考，不构成投资、法律或职业建议。</p>
    </div>
  </div>
</footer>
