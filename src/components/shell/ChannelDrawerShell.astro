---
import BrandLogo from "./BrandLogo.astro";
import ChannelSidebar from "@/components/channel/ChannelSidebar.astro";
import type { Channel } from "@/modules/channel/model";

type Props = {
  topics: Channel[];
  selectedChannel?: string;
  showMobileChannels?: boolean;
};

const { topics, selectedChannel, showMobileChannels = true } = Astro.props;
---
<div
  data-site-content-offset
  class="relative flex flex-1 flex-col lg:flex-row lg:items-stretch lg:pl-[200px] xl:pl-[220px] 2xl:pl-[240px]"
>
  {showMobileChannels ? (
    <aside
      data-mobile-drawer
      class="no-scrollbar fixed left-0 top-[var(--site-header-height)] z-20 h-[calc(100vh_-_var(--site-header-height))] w-[15rem] overflow-y-auto border-r border-slate-200 bg-surface p-3 shadow-[8px_0_30px_rgba(15,23,42,0.10)] lg:hidden"
    >
      <ChannelSidebar topics={topics} selectedLabel={selectedChannel} frameless />
    </aside>
  ) : null}

  <aside
    data-site-sidebar
    class="fixed left-0 top-[var(--site-header-height)] bottom-0 z-30 hidden w-[200px] border-r border-slate-200 bg-surface lg:block xl:w-[220px] 2xl:w-[240px]"
  >
    <div class="flex h-full flex-col overflow-hidden px-3 pb-4 pt-5">
      <div data-sidebar-header class="mb-4 flex h-9 flex-none items-center pl-[12px]">
        <span data-sidebar-brand>
          <span data-sidebar-brand-full>
            <BrandLogo />
          </span>
          <span data-sidebar-brand-compact>
            <a
              href="/"
              data-nav-link
              aria-label="NewHot 首页"
              title="NewHot"
              class="flex h-8 w-8 items-center justify-center rounded-lg transition-transform hover:scale-105"
            >
              <img src="/favicon.svg" alt="NewHot" width="32" height="32" class="h-8 w-8 rounded-lg" />
            </a>
          </span>
        </span>
      </div>

      <ChannelSidebar topics={topics} selectedLabel={selectedChannel} frameless />
    </div>

    <button
      type="button"
      data-sidebar-toggle
      aria-label="收起侧边栏"
      aria-pressed="false"
      title="收起侧边栏"
      class="absolute -right-3 top-[26px] z-20 flex h-6 w-6 items-center justify-center rounded-full border border-slate-200 bg-surface text-slate-400 shadow-[0_2px_10px_rgba(15,23,42,0.12)] transition-colors hover:border-slate-300 hover:bg-slate-50 hover:text-slate-700"
    >
      <span data-collapse-icon>
        <svg viewBox="0 0 16 16" aria-hidden="true" class="h-[13px] w-[13px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9.75 3.5 5.25 8l4.5 4.5" />
        </svg>
      </span>
      <span data-expand-icon>
        <svg viewBox="0 0 16 16" aria-hidden="true" class="h-[13px] w-[13px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6.25 3.5 10.75 8l-4.5 4.5" />
        </svg>
      </span>
    </button>
  </aside>

  <div
    data-site-content-wrap
    class="flex min-w-0 flex-1 flex-col transition-transform duration-300 lg:transform-none lg:transition-none"
  >
    <slot />
  </div>
</div>
