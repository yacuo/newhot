---
import Icon from "@/components/ui/Icon.astro";
---
<button
  type="button"
  data-back-to-top
  aria-label="回到顶部"
  title="回到顶部"
  tabindex="-1"
  aria-hidden="true"
  class="fixed bottom-5 right-5 z-40 flex h-10 w-10 items-center justify-center rounded-full bg-indigo-600 text-[color:var(--accent-on)] shadow-[0_8px_24px_-10px_rgba(15,23,42,0.55)] ring-1 ring-indigo-700/20 transition-all duration-200 hover:bg-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
>
  <Icon name="ArrowUp" size={16} strokeWidth={2.4} />
</button>
