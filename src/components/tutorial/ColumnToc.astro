---
import type { ResolvedTutorialCatalog } from "@/modules/tutorial";

type Props = {
  column: ResolvedTutorialCatalog;
  activeSlug?: string;
  label?: string;
  compact?: boolean;
};

const { column, activeSlug, label = "系列教程目录", compact = false } = Astro.props;

const linkClass = (active: boolean) =>
  active
    ? "block rounded-md bg-slate-100 px-2.5 py-1.5 font-medium text-slate-950"
    : "block rounded-md px-2.5 py-1.5 text-slate-600 transition-[background-color,color] hover:bg-slate-50 hover:text-slate-950";
---
<nav aria-label={label} class={compact ? "text-sm" : "text-sm"}>
  {compact ? null : (
    <a href={`/tutorials/${column.id}/`} class="group mb-4 block px-3 py-3 transition-colors">
      <span class="line-clamp-2 block text-sm font-bold leading-5 text-slate-950">{column.title}</span>
      <span class="mt-1 block text-xs text-slate-500">本专栏共 {column.articleCount} 篇文章</span>
    </a>
  )}
  <div class={compact ? "space-y-2.5" : "space-y-3"}>
    {column.sections.map((section) => (
      <section class={compact ? "min-w-0" : ""}>
        <p class={compact ? "mb-1 truncate px-2 text-[11px] font-semibold tracking-wide text-slate-400" : "mb-1.5 px-2.5 text-sm font-bold text-slate-800"}>
          {section.title}
        </p>
        <ol class="space-y-0.5">
          {section.articles.map((article) => {
            const active = Boolean(activeSlug && article.slug === activeSlug);
            const content = compact ? (
              <span class="flex min-w-0 items-center gap-2">
                <span class="min-w-0 flex-1 truncate text-[13px] leading-5">{article.sidebarTitle}</span>
                {article.badge ? (
                  <span class={`shrink-0 rounded px-1.5 py-0.5 text-[10px] leading-4 ${active ? "bg-surface text-slate-950" : "bg-slate-100 text-slate-400"}`}>
                    {article.badge}
                  </span>
                ) : null}
              </span>
            ) : (
              <span class="flex items-center gap-2">
                <span class="line-clamp-2 min-w-0 flex-1 text-[13px] leading-5">{article.sidebarTitle}</span>
                {article.badge ? (
                  <span class={`shrink-0 rounded px-1.5 py-0.5 text-[10px] ${active ? "bg-surface text-slate-950" : "bg-slate-100 text-slate-400"}`}>
                    {article.badge}
                  </span>
                ) : null}
              </span>
            );

            return (
              <li class={compact ? "min-w-0" : ""}>
                {article.external ? (
                  <a href={article.href} target="_blank" rel="noreferrer" class={linkClass(active)} data-mobile-column-link>
                    {content}
                  </a>
                ) : (
                  <a href={article.href} class={linkClass(active)} data-mobile-column-link>
                    {content}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </div>
</nav>
