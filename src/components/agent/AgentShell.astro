---
import PageHeader from "@/components/ui/PageHeader.astro";
import Icon from "@/components/ui/Icon.astro";
import AgentCards from "./AgentCards.astro";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;

const groups = [
  {
    title: "机器接口",
    desc: "RSS、REST API、MCP 与 OpenAPI",
    entries: [
      { label: "RSS", href: "/feed.xml", note: "原生 feed" },
      { label: "REST API", href: "/api/v1/articles", note: "查询文章" },
      { label: "MCP", href: "/agent/mcp/", note: "POST /api/v1/mcp" },
      { label: "OpenAPI", href: "/openapi-v1.json", note: "接口定义" },
    ],
  },
  {
    title: "Agent Skill",
    desc: "页面、安装说明与源文件",
    entries: [
      { label: "Skill 页面", href: "/agent/skill/", note: "安装与使用" },
      { label: "安装说明", href: "/newhot-skill/README.md", note: "README.md" },
      { label: "Skill 源文件", href: "/newhot-skill/SKILL.md", note: "SKILL.md" },
    ],
  },
];
---

<div class="space-y-5">
  <PageHeader eyebrow="AGENT" title={title} description={description} />

  <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_280px]">
    <div class="min-w-0 space-y-5">
      <AgentCards />
      <slot />
    </div>

    <aside class="space-y-4 xl:sticky xl:top-4 xl:self-start">
      {groups.map((group, index) => (
        <section class="rounded-2xl bg-surface p-5 ring-1 ring-slate-900/[0.06]">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="text-sm font-semibold text-slate-900">{group.title}</p>
              <p class="mt-0.5 text-[11px] text-slate-400">{group.desc}</p>
            </div>
            {index === 0 ? (
              <a href="/agent/" class="shrink-0 text-[11px] font-medium text-indigo-600 hover:underline">总览</a>
            ) : null}
          </div>
          <ul class="mt-3 space-y-1">
            {group.entries.map((entry) => (
              <li>
                <a
                  href={entry.href}
                  class="group -mx-2 flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 transition-colors hover:bg-slate-50 hover:ring-1 hover:ring-slate-900/[0.04]"
                >
                  <span class="min-w-0">
                    <span class="block text-[13px] font-medium text-slate-800 group-hover:text-indigo-600">{entry.label}</span>
                    <span class="mt-0.5 block truncate font-mono text-[11px] text-slate-400">{entry.note}</span>
                  </span>
                  <Icon
                    name="ArrowRight"
                    size={13}
                    class="shrink-0 text-slate-300 opacity-0 transition-all group-hover:translate-x-0.5 group-hover:opacity-100"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="rounded-2xl bg-surface p-5 ring-1 ring-slate-900/[0.06]">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">共同约定</p>
        <ul class="mt-3 space-y-2 text-[13px] leading-6 text-slate-500">
          <li>只读，不提供写入或登录。</li>
          <li>只返回元数据与摘要，不返回正文。</li>
          <li>时间以 <span class="font-mono text-[11px] text-slate-700">publishedAt</span> 为准。</li>
          <li>引用时链接 canonical 页面。</li>
          <li>只提供最近 7 天的文章，不返回历史全量。</li>
          <li>同一条请求 1 次/10 分钟（查询、索引、快照三档），MCP 每 IP 60 次/10 分钟，RSS 不限流，超出返回 429。</li>
        </ul>
      </section>
    </aside>
  </div>
</div>

<script>
  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLElement>("[data-copy]");
    if (!button) return;

    const text = button.dataset.copy ?? "";
    const label = button.dataset.label ?? button.textContent ?? "复制";

    try {
      await navigator.clipboard.writeText(text);
      button.textContent = "已复制";
    } catch {
      button.textContent = "复制失败";
    }

    setTimeout(() => {
      button.textContent = label;
    }, 1500);
  });
</script>
