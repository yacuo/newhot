---
import Icon from "@/components/ui/Icon.astro";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const cards = [
  {
    name: "RSS",
    href: "/agent/rss/",
    icon: "Radio",
    short: "阅读器与抓取",
    desc: "阅读器、内容管线与 AI 抓取。",
    meta: "/feed.xml",
    accent: "text-orange-500",
    accentIdle: "text-orange-400",
    border: "border-orange-500",
    bg: "bg-orange-50/70",
    dot: "bg-orange-400",
  },
  {
    name: "REST API",
    href: "/agent/api/",
    icon: "CodeXml",
    short: "脚本与看板",
    desc: "脚本、机器人与看板取数。",
    meta: "/api/v1/articles",
    accent: "text-sky-500",
    accentIdle: "text-sky-400",
    border: "border-sky-500",
    bg: "bg-sky-50/70",
    dot: "bg-sky-400",
  },
  {
    name: "MCP",
    href: "/agent/mcp/",
    icon: "Route",
    short: "Agent 客户端",
    desc: "Claude Code、Cursor 等客户端直接调用。",
    meta: "/api/v1/mcp",
    accent: "text-violet-500",
    accentIdle: "text-violet-400",
    border: "border-violet-500",
    bg: "bg-violet-50/70",
    dot: "bg-violet-400",
  },
  {
    name: "Agent Skill",
    href: "/agent/skill/",
    icon: "WandSparkles",
    short: "装一次就能用",
    desc: "告诉 Agent 什么时候用、怎么引用。",
    meta: "/newhot-skill/README.md",
    accent: "text-emerald-500",
    accentIdle: "text-emerald-400",
    border: "border-emerald-500",
    bg: "bg-emerald-50/70",
    dot: "bg-emerald-400",
  },
] as const;

const isActive = (href: string) => pathname === href.replace(/\/+$/, "");
const activeCard = cards.find((card) => isActive(card.href));
---

<div class="rounded-2xl bg-surface p-3 ring-1 ring-slate-900/[0.06]">
  <div class="border-b border-slate-200">
    <nav class="flex overflow-x-auto overflow-y-hidden" aria-label="Agent 接入方式">
      {cards.map((card) => {
        const active = isActive(card.href);
        return (
          <a
            href={card.href}
            aria-current={active ? "page" : undefined}
            class={`group relative -mb-px flex min-w-[150px] flex-1 flex-col gap-0.5 rounded-t-lg border-b-2 px-4 py-3.5 transition-colors ${
              active ? `${card.border} ${card.bg}` : "border-transparent hover:bg-slate-50"
            }`}
          >
            <span
              class={`flex items-center gap-1.5 text-base font-semibold ${
                active ? "text-slate-950" : "text-slate-600 group-hover:text-slate-950"
              }`}
            >
              <Icon
                name={card.icon}
                size={16}
                strokeWidth={1.9}
                class={active ? card.accent : card.accentIdle}
              />
              <span class="whitespace-nowrap">{card.name}</span>
            </span>
            <span class={`pl-[22px] text-[12px] ${active ? "text-slate-500" : "text-slate-400"}`}>
              {card.short}
            </span>
          </a>
        );
      })}
    </nav>
  </div>

  <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 px-1 text-[12px] text-slate-500">
    <span class="flex items-center gap-1.5">
      <span class={`h-1.5 w-1.5 rounded-full ${activeCard?.dot ?? "bg-slate-300"}`} />
      <span class="font-mono text-[11px] text-slate-600">{activeCard?.meta ?? "匿名只读 · 无需 Key"}</span>
    </span>
    <span>{activeCard?.desc ?? "四种方式读的是同一份数据，选一个就行。"}</span>
  </p>
</div>
