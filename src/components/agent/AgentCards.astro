---
import Icon from "@/components/ui/Icon.astro";
import { agentPage } from "@/modules/page-content/agent";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const { cards, fallback } = agentPage.nav;

const tones = {
  orange: { accent: "text-orange-500", accentIdle: "text-orange-400", border: "border-orange-500", bg: "bg-orange-50/70", dot: "bg-orange-400" },
  sky: { accent: "text-sky-500", accentIdle: "text-sky-400", border: "border-sky-500", bg: "bg-sky-50/70", dot: "bg-sky-400" },
  violet: { accent: "text-violet-500", accentIdle: "text-violet-400", border: "border-violet-500", bg: "bg-violet-50/70", dot: "bg-violet-400" },
  emerald: { accent: "text-emerald-500", accentIdle: "text-emerald-400", border: "border-emerald-500", bg: "bg-emerald-50/70", dot: "bg-emerald-400" },
} as const;

const isActive = (href: string) => pathname === href.replace(/\/+$/, "");
const activeCard = cards.find((card) => isActive(card.href));
---

<div class="rounded-2xl bg-surface p-3 ring-1 ring-slate-900/[0.06]">
  <div class="border-b border-slate-200">
    <nav class="flex overflow-x-auto overflow-y-hidden" aria-label="Agent 接入方式">
      {cards.map((card) => {
        const active = isActive(card.href);
        const tone = tones[card.tone];
        return (
          <a
            href={card.href}
            aria-current={active ? "page" : undefined}
            class={`group relative -mb-px flex min-w-[150px] flex-1 flex-col gap-0.5 rounded-t-lg border-b-2 px-4 py-3.5 transition-colors ${
              active ? `${tone.border} ${tone.bg}` : "border-transparent hover:bg-slate-50"
            }`}
          >
            <span
              class={`flex items-center gap-1.5 text-base font-semibold ${
                active ? "text-slate-950" : "text-slate-600 group-hover:text-slate-950"
              }`}
            >
              <Icon
                name={card.icon}
                size={16}
                strokeWidth={1.9}
                class={active ? tone.accent : tone.accentIdle}
              />
              <span class="whitespace-nowrap">{card.name}</span>
            </span>
            <span class={`pl-[22px] text-[12px] ${active ? "text-slate-500" : "text-slate-400"}`}>
              {card.short}
            </span>
          </a>
        );
      })}
    </nav>
  </div>

  <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 px-1 text-[12px] text-slate-500">
    <span class="flex items-center gap-1.5">
      <span class={`h-1.5 w-1.5 rounded-full ${activeCard ? tones[activeCard.tone].dot : "bg-slate-300"}`} />
      <span class="font-mono text-[11px] text-slate-600">{activeCard?.meta ?? fallback.meta}</span>
    </span>
    <span>{activeCard?.description ?? fallback.description}</span>
  </p>
</div>
