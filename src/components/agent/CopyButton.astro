---
type Props = {
  text: string;
  label?: string;
  tone?: "light" | "dark";
};

const { text, label = "复制", tone = "light" } = Astro.props;

const baseClass = "shrink-0 rounded-md px-2 py-1 text-[11px] font-medium transition";
const toneClass =
  tone === "dark"
    ? "bg-slate-800 text-slate-200 hover:bg-slate-700"
    : "border border-slate-200 bg-white text-slate-500 hover:text-indigo-600";
---

<button type="button" data-copy={text} data-label={label} class={`${baseClass} ${toneClass}`}>{label}</button>
