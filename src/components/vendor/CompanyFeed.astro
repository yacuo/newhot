---
import ArticleTimeline from "@/components/channel/ArticleTimeline.astro";
import type { ArticleListItem } from "@/modules/content/schema";
import { topics } from "@/modules/channel";
import { getTopicAccent } from "@/modules/channel/accents";
import { buildChannelFacets, buildProductFacets, mapProductIds } from "@/modules/vendor/facets";
import { getChildCompanies, type Company } from "@/modules/vendor/model";
import { pillActiveClass, pillIdleClass, pillTrayClass } from "@/shared/ui/classes";

type Props = {
  company: Company;
  scope: string;
  initialItems: ArticleListItem[];
  total: number;
};

const { company, scope, initialItems, total } = Astro.props;

const channelFacets = buildChannelFacets(initialItems);
const productFacets = buildProductFacets(company, initialItems);
const productMap = mapProductIds(company, initialItems);

const children = getChildCompanies(company.id);
const productNames: Record<string, string> = {};
for (const owner of [company, ...children]) {
  for (const product of owner.products) {
    productNames[`${owner.id}:${product.id}`] = owner.id === company.id ? product.name : `${owner.name} ${product.name}`;
  }
}

const channelMeta: Record<string, { label: string; dot: string; text: string }> = {};
for (const topic of topics) {
  const accent = getTopicAccent(topic.id);
  channelMeta[topic.id] = { label: topic.label, dot: accent.dot, text: accent.text };
}

const payload = {
  scope,
  total,
  companyId: company.id,
  items: initialItems,
  productMap: Object.fromEntries(productMap),
  productNames,
  channelMeta,
};
---
<div data-company-feed>
  <div data-company-channels hidden={channelFacets.length <= 1} class="-mx-1 overflow-x-auto px-1 [scrollbar-width:none] [mask-image:linear-gradient(to_right,#000_calc(100%-24px),transparent)] [&::-webkit-scrollbar]:hidden">
    <div class={pillTrayClass}>
      <button
        type="button"
        data-company-channel="all"
        aria-pressed="true"
        class={`inline-flex shrink-0 items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[13px] transition ${pillActiveClass}`}
      >
        全部
        <span class="pill-count font-mono text-[11px] text-white/70">{initialItems.length}</span>
      </button>
      {channelFacets.map((facet) => (
        <button
          type="button"
          data-company-channel={facet.id}
          aria-pressed="false"
          class={`inline-flex shrink-0 items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[13px] transition ${pillIdleClass}`}
        >
          <span class={`h-1.5 w-1.5 rounded-full ${facet.dot}`}></span>
          {facet.label}
          <span class="pill-count font-mono text-[11px] text-slate-400">{facet.count}</span>
        </button>
      ))}
    </div>
  </div>

  <div data-company-products hidden={productFacets.length <= 1} class={`flex flex-wrap items-center gap-2 pl-1.5 ${channelFacets.length > 1 && productFacets.length > 1 ? "mt-2.5" : ""}`}>
    <button
      type="button"
      data-company-product="all"
      aria-pressed="true"
      class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[13px] transition ${pillActiveClass}`}
    >
      全部
      <span class="pill-count font-mono text-[11px] text-white/70">{initialItems.length}</span>
    </button>
    {productFacets.map((facet) => (
      <button
        type="button"
        data-company-product={facet.id}
        aria-pressed="false"
        class="inline-flex items-center gap-1.5 rounded-full bg-surface px-3 py-1.5 text-[13px] text-slate-600 ring-1 ring-slate-900/[0.08] transition hover:text-indigo-700 hover:ring-indigo-200"
      >
        {facet.name}
        <span class="pill-count font-mono text-[11px] text-slate-400">{facet.count}</span>
      </button>
    ))}
  </div>

  <div class="mt-3" data-company-timeline>
    <ArticleTimeline items={initialItems} showTopic showSubcategory companyId={company.id} productMap={productMap} empty={total === 0} />
  </div>

  {initialItems.length < total ? (
    <div data-company-more class="mt-3 border-t border-slate-100 pt-3 text-center">
      <button type="button" data-company-load class="rounded-full border border-indigo-200 px-4 py-1.5 text-xs text-indigo-600 transition-colors hover:border-indigo-300 hover:bg-indigo-50">
        加载更多（已加载 {initialItems.length} / {total} 篇）
      </button>
    </div>
  ) : null}
</div>

<script type="application/json" data-company-data set:html={JSON.stringify(payload)} />

<script>
  import "../../scripts/company-feed";
</script>
