---
import CompanyCard from "./CompanyCard.astro";
import { pillActiveClass, pillCountClass, pillIdleClass } from "@/shared/ui/classes";
import { themeHref, type ThemeSection } from "@/modules/vendor/themes";

type Block = {
  id: string;
  name: string;
  description: string;
  companyCount: number;
  articleCount: number;
  sections: ThemeSection[];
};

type Props = { blocks: Block[] };
const { blocks } = Astro.props;
---
<div data-theme-explorer>
  <div class="mt-4 rounded-2xl bg-surface p-2 md:p-4">
    <div class="-mx-1 overflow-x-auto px-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <div role="tablist" aria-label="切换主题" class="inline-flex w-max items-center gap-0.5 rounded-full bg-slate-200 p-1.5">
        {blocks.map((block, index) => (
          <button
            type="button"
            role="tab"
            data-theme-tab={block.id}
            aria-selected={index === 0 ? "true" : "false"}
            class={`shrink-0 rounded-full px-5 py-2.5 text-[15px] tracking-[-0.01em] transition ${
              index === 0 ? "pill-active bg-indigo-600 font-semibold text-white" : "font-medium text-slate-600 hover:bg-raised hover:text-slate-950"
            }`}
          >
            {block.name}
          </button>
        ))}
      </div>
    </div>

    {blocks.map((block, index) => (
      <div data-theme-meta={block.id} hidden={index !== 0}>
        <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-1">
          <p class="max-w-2xl text-[13px] leading-6 text-slate-500">{block.description}</p>
          <div class="flex shrink-0 items-center gap-3 font-mono text-[11px] tracking-[0.04em] text-slate-400">
            <span>
              {block.companyCount} 家公司
              <span class="mx-1.5 text-slate-300">·</span>
              {block.articleCount} 篇动态
            </span>
            <a href={themeHref(block.id)} class="text-indigo-600 transition hover:text-indigo-700">单独查看 →</a>
          </div>
        </div>

        <div data-theme-groups={block.id} data-active-group="all" class="mt-2.5 overflow-x-auto pl-0.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          <nav aria-label={`${block.name}分类`} class="inline-flex w-max items-center gap-0.5 rounded-full bg-slate-100 p-1">
            <button
              type="button"
              data-theme-group="all"
              aria-pressed="true"
              class={`inline-flex shrink-0 items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[13px] transition ${pillActiveClass}`}
            >
              全部
              <span class={pillCountClass(true)}>{block.companyCount}</span>
            </button>
            {block.sections.map((section) => (
              <button
                type="button"
                data-theme-group={section.id}
                aria-pressed="false"
                class={`inline-flex shrink-0 items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[13px] transition ${pillIdleClass}`}
              >
                {section.label}
                <span class={pillCountClass(false)}>{section.summaries.length}</span>
              </button>
            ))}
          </nav>
        </div>
      </div>
    ))}
  </div>

  {blocks.map((block, index) => (
    <div data-theme-block={block.id} hidden={index !== 0}>
      {block.sections.map((section) => (
        <div data-theme-section={section.id} class="mt-5">
          <div data-theme-section-heading class="mb-3 flex items-baseline gap-2">
            <h2 class="text-[13px] font-semibold tracking-[-0.01em] text-slate-700">{section.label}</h2>
            <span class="font-mono text-[11px] tabular-nums text-slate-400">{section.summaries.length}</span>
          </div>
          <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
            {section.summaries.map((summary) => (
              <CompanyCard summary={summary} />
            ))}
          </div>
        </div>
      ))}
    </div>
  ))}
</div>

<script>
  import "../../scripts/theme-explorer";
</script>
