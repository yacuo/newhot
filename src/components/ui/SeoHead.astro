---
import { getSiteUrl, siteConfig } from "@/shared/site";

type Props = {
  title?: string;
  description?: string;
  path?: string;
  type?: "website" | "article";
  post?: { date: string; updated?: string };
  authors?: string[];
  section?: string;
  absoluteTitle?: boolean;
};

const {
  title: rawTitle,
  description = siteConfig.description,
  path = "/",
  type = "website",
  post,
  authors,
  section,
  absoluteTitle = false,
} = Astro.props;

const title = absoluteTitle
  ? rawTitle ?? siteConfig.name
  : rawTitle
    ? `${rawTitle} | ${siteConfig.name}`
    : siteConfig.name;
const url = getSiteUrl(path);
const ogImageUrl = getSiteUrl(siteConfig.ogImage);
---
<title>{title}</title>
<meta name="description" content={description} />
{section ? <meta name="category" content={section} /> : null}
{authors?.length ? <meta name="author" content={authors.join(", ")} /> : null}
<link rel="canonical" href={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={type} />
{post ? <meta property="article:published_time" content={post.date} /> : null}
{post ? <meta property="article:modified_time" content={post.updated ?? post.date} /> : null}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${siteConfig.name} 默认分享图`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
