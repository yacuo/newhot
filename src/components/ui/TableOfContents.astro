---
import type { TableOfContentsItem } from "@/modules/content/schema";

type Props = { headings: TableOfContentsItem[]; showTitle?: boolean };

const { headings, showTitle = true } = Astro.props;

const getIndent = (level: number) => (level >= 4 ? "pl-6" : level === 3 ? "pl-3" : "pl-0");

/** 按层级生成 1、1.1、1.1.1 这样的编号；缺少上级时按第一项补 1 */
const counters = [0, 0, 0];
const numbered = headings.map((heading) => {
  const level = Math.min(Math.max(heading.level, 2), 4);
  const index = level - 2;
  counters[index] += 1;
  for (let i = index + 1; i < counters.length; i += 1) counters[i] = 0;
  for (let i = 0; i < index; i += 1) {
    if (counters[i] === 0) counters[i] = 1;
  }
  return { ...heading, number: counters.slice(0, index + 1).join(".") };
});
---
{headings.length ? (
  <nav data-toc class="text-[13px] leading-5">
    {showTitle ? (
      <p class="mb-3 text-[11px] font-medium tracking-[0.12em] text-slate-400">文章目录</p>
    ) : null}
    <ol class="space-y-1 text-slate-500">
      {numbered.map((heading) => (
        <li class={getIndent(heading.level)}>
          <a
            href={`#${heading.id}`}
            data-toc-link={heading.id}
            title={heading.text}
            class="flex items-baseline gap-2 rounded-md py-1.5 pl-1.5 pr-2 transition-colors hover:bg-slate-100 hover:text-slate-900"
          >
            <span class="flex-none font-mono text-[11px] tabular-nums text-slate-400">{heading.number}</span>
            <span class="min-w-0 truncate">{heading.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
) : null}
